  <PropertyGroup>
    <AssemblyName>MaterialManager_V01</AssemblyName>
    <IntermediateOutputPath>obj\Debug\</IntermediateOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>D:\MaterialManager_V01_komplett\obj\</MSBuildProjectExtensionsPath>
    <_TargetAssemblyProjectName>MaterialManager_V01</_TargetAssemblyProjectName>
    <RootNamespace>MaterialManager_V01</RootNamespace>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <RootNamespace>MaterialManager_V01</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <!-- WICHTIG: Manifest = KEINE Admin-Rechte! -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- App-Informationen (reduziert SmartScreen-Warnungen) -->
    <Version>1.0.7</Version>
    <FileVersion>1.0.7.0</FileVersion>
    <AssemblyVersion>1.0.7.0</AssemblyVersion>
    <InformationalVersion>1.0.7</InformationalVersion>
    <Product>MaterialManager V01</Product>
    <Company>Alexander Hoelzer</Company>
    <Description>Materialverwaltung für Blechlager - Vollversion mit Lizenzierung</Description>
    <Copyright>Copyright © 2026 Alexander Hoelzer</Copyright>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Self-Contained Settings für USB-Distribution -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Code-Signing Vorbereitung -->
    <SignAssembly>false</SignAssembly>
    <DelaySign>false</DelaySign>
  </PropertyGroup>
  <!-- USB Publication Profile -->
  <PropertyGroup Condition="'$(PublishProfile)' == 'USBVersion'">
    <PublishDir>.\USB_Package\</PublishDir>
    <StripSymbols>true</StripSymbols>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>
