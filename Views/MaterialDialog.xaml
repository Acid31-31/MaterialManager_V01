<Window x:Class="MaterialManager_V01.Views.MaterialDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MaterialManager_V01.Converters"
        Title="Material"
        Height="680" Width="440" MinWidth="360" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        Foreground="Black"
        KeyDown="OnKeyDown">

    <Window.Resources>
        <conv:StaerkeFormatConverter x:Key="StaerkeFormat"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="Black" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="BorderBrush" Value="#AAAAAA" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"/>

                            <ToggleButton
                                Name="MainToggleArea"
                                Grid.Column="0"
                                Focusable="False"
                                IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                ClickMode="Press"
                                Background="Transparent"
                                BorderThickness="0"/>

                            <!-- Zeigt den gewählten Text mit expliziter Farbe -->
                            <TextBlock
                                Name="ContentSite"
                                Grid.Column="0"
                                IsHitTestVisible="False"
                                Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectionBoxItem}"
                                Foreground="Black"
                                Margin="4,2,28,2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                TextTrimming="CharacterEllipsis"/>

                            <TextBox
                                x:Name="PART_EditableTextBox"
                                Grid.Column="0"
                                Visibility="Hidden"
                                IsReadOnly="{TemplateBinding IsReadOnly}"
                                Background="Transparent"
                                Foreground="Black"
                                CaretBrush="Black"
                                BorderThickness="0"
                                Padding="4,2"
                                Margin="1,1,28,1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"/>

                            <ToggleButton
                                Name="ToggleButton"
                                Grid.Column="1"
                                Focusable="false"
                                IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                ClickMode="Press"
                                Background="#E0E0E0"
                                BorderBrush="#AAAAAA"
                                BorderThickness="1,0,0,0">
                                <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="#444444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </ToggleButton>

                            <Popup
                                Name="Popup"
                                Placement="Bottom"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                AllowsTransparency="True"
                                Focusable="False"
                                PopupAnimation="Slide">
                                <Grid
                                    Name="DropDown"
                                    SnapsToDevicePixels="True"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border
                                        x:Name="DropDownBorder"
                                        Background="White"
                                        BorderThickness="1"
                                        BorderBrush="#AAAAAA">
                                        <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="MainToggleArea" Property="IsChecked" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border
                            Name="Border"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}">
                            <Border.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="Black"/>
                                </Style>
                            </Border.Resources>
                            <TextBlock Text="{Binding}" Foreground="Black"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#DDEEFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#CCE5FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="BorderBrush" Value="#AAAAAA" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource AppButton3DPrimaryStyle}">
            <Setter Property="Padding" Value="8,4" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <!-- 0: Kategorie -->
                <RowDefinition Height="Auto"/>
                <!-- 1: MaterialArt -->
                <RowDefinition Height="Auto"/>
                <!-- 2: Legierung -->
                <RowDefinition Height="Auto"/>
                <!-- 3: Oberfläche -->
                <RowDefinition Height="Auto"/>
                <!-- 4: Güte -->
                <RowDefinition Height="Auto"/>
                <!-- 5: Blech-Felder -->
                <RowDefinition Height="Auto"/>
                <!-- 6: Rohr-Felder -->
                <RowDefinition Height="Auto"/>
                <!-- 7: Profil-Felder -->
                <RowDefinition Height="Auto"/>
                <!-- 8: Restnummer -->
                <RowDefinition Height="Auto"/>
                <!-- 9: Lagerort -->
                <RowDefinition Height="Auto"/>
                <!-- 10: Datum -->
                <RowDefinition Height="Auto"/>
                <!-- 11: Lieferant / Lieferschein -->
                <RowDefinition Height="Auto"/>
                <!-- 12: Preis / Wert -->
                <RowDefinition Height="Auto"/>
                <!-- 13: Regal-Auslastung -->
                <RowDefinition Height="Auto"/>
                <!-- 14: Buttons -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Kategorie ───────────────────────────────────────────────── -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Kategorie:" VerticalAlignment="Center" Margin="0,5"
                       FontWeight="Bold" Foreground="#2E7D32"/>
            <ComboBox Grid.Row="0" Grid.Column="1"
                      ItemsSource="{Binding Kategorien}"
                      SelectedItem="{Binding SelectedKategorie, Mode=TwoWay}"
                      Margin="0,5"/>

            <!-- ── Gemeinsam ───────────────────────────────────────────────── -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Materialart:" VerticalAlignment="Center" Margin="0,5"/>
            <ComboBox Grid.Row="1" Grid.Column="1"
                      ItemsSource="{Binding MaterialArten}"
                      SelectedItem="{Binding SelectedMaterialArt, Mode=TwoWay}"
                      Margin="0,5"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Legierung:" VerticalAlignment="Center" Margin="0,5"/>
            <ComboBox Grid.Row="2" Grid.Column="1"
                      ItemsSource="{Binding Legierungen}"
                      SelectedItem="{Binding SelectedLegierung, Mode=TwoWay}"
                      Margin="0,5"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Oberfläche:" VerticalAlignment="Center" Margin="0,5"/>
            <ComboBox Grid.Row="3" Grid.Column="1"
                      ItemsSource="{Binding Oberflaechen}"
                      SelectedItem="{Binding SelectedOberflaeche, Mode=TwoWay}"
                      Margin="0,5"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Güte:" VerticalAlignment="Center" Margin="0,5"
                       Visibility="{Binding GueteVisible}"/>
            <ComboBox Grid.Row="4" Grid.Column="1"
                      ItemsSource="{Binding Gueten}"
                      SelectedItem="{Binding SelectedGuete, Mode=TwoWay}"
                      Visibility="{Binding GueteVisible}"
                      Margin="0,5"/>

            <!-- ── Blech-Felder ────────────────────────────────────────────── -->
            <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Visibility="{Binding BlechFelderVisible}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Form:" VerticalAlignment="Center" Margin="0,5"/>
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              ItemsSource="{Binding Formen}"
                              SelectedItem="{Binding SelectedForm, Mode=TwoWay}"
                              Margin="0,5"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Stärke (mm):" VerticalAlignment="Center" Margin="0,5"/>
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              x:Name="StaerkeBox"
                              ItemsSource="{Binding Staerken}"
                              SelectedItem="{Binding SelectedStaerke, Mode=TwoWay}"
                              Text="{Binding SelectedStaerkeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              StaysOpenOnEdit="True"
                              Foreground="Black"
                              Background="White"
                              BorderBrush="#AAAAAA"
                                                                  PreviewMouseLeftButtonDown="StaerkeBox_PreviewMouseLeftButtonDown"
                              Margin="0,5">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource StaerkeFormat}}" Foreground="Black"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Maß (LxB mm):" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Grid.Row="2" Grid.Column="1"
                             Text="{Binding Mass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsMassEditable}"
                             Margin="0,5"/>
                </Grid>

                <!-- Stückzahl nur bei GF/MF/KF -->
                <Grid Visibility="{Binding StueckzahlVisible}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Stückzahl:" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Grid.Column="1" Text="{Binding Stueckzahl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,5"/>
                </Grid>
            </StackPanel>

            <!-- ── Rohr-Felder ─────────────────────────────────────────────── -->
            <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Visibility="{Binding RohrFelderVisible}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Rohrform:" VerticalAlignment="Center" Margin="0,5"/>
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              ItemsSource="{Binding RohrFormen}"
                              SelectedItem="{Binding SelectedRohrForm, Mode=TwoWay}"
                              Margin="0,5"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Außen-Ø (mm):" VerticalAlignment="Center" Margin="0,5"
                               Visibility="{Binding RohrRundVisible}"/>
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              ItemsSource="{Binding RohrDurchmesser}"
                              Text="{Binding SelectedDurchmesser, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True" Margin="0,5" Visibility="{Binding RohrRundVisible}"
                              Foreground="Black" Background="White" BorderBrush="#AAAAAA"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Höhe außen (mm):" VerticalAlignment="Center" Margin="0,5"
                               Visibility="{Binding RohrEckigVisible}"/>
                    <ComboBox Grid.Row="2" Grid.Column="1"
                              ItemsSource="{Binding RohrKantenmasse}"
                              Text="{Binding SelectedRohrHoehe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True" Margin="0,5" Visibility="{Binding RohrEckigVisible}"
                              Foreground="Black" Background="White" BorderBrush="#AAAAAA"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Breite außen (mm):" VerticalAlignment="Center" Margin="0,5"
                               Visibility="{Binding RohrBreiteVisible}"/>
                    <ComboBox Grid.Row="3" Grid.Column="1"
                              ItemsSource="{Binding RohrKantenmasse}"
                              Text="{Binding SelectedRohrBreite, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True" Margin="0,5" Visibility="{Binding RohrBreiteVisible}"
                              Foreground="Black" Background="White" BorderBrush="#AAAAAA"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Wandstärke (mm):" VerticalAlignment="Center" Margin="0,5"/>
                    <ComboBox Grid.Row="4" Grid.Column="1"
                              ItemsSource="{Binding RohrWandstaerken}"
                              Text="{Binding SelectedRohrWand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True" Margin="0,5"
                              Foreground="Black" Background="White" BorderBrush="#AAAAAA"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Länge (mm):" VerticalAlignment="Center" Margin="0,5"/>
                    <ComboBox Grid.Row="5" Grid.Column="1"
                              ItemsSource="{Binding StandardLaengen}"
                              Text="{Binding SelectedLaenge, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True" Margin="0,5"
                              Foreground="Black" Background="White" BorderBrush="#AAAAAA"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Stückzahl:" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Grid.Row="6" Grid.Column="1"
                             Text="{Binding Stueckzahl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,5"/>
                </Grid>
            </StackPanel>

            <!-- ── Profil-Felder ───────────────────────────────────────────── -->
            <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Visibility="{Binding ProfilFelderVisible}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Profiltyp:" VerticalAlignment="Center" Margin="0,5"/>
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              ItemsSource="{Binding ProfilTypen}"
                              Text="{Binding SelectedProfilTyp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True" Margin="0,5"
                              Foreground="Black" Background="White" BorderBrush="#AAAAAA"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Höhe h (mm):" VerticalAlignment="Center" Margin="0,5"/>
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              ItemsSource="{Binding ProfilHoehen}"
                              Text="{Binding SelectedProfilHoehe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True" Margin="0,5"
                              Foreground="Black" Background="White" BorderBrush="#AAAAAA"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Breite b (mm):" VerticalAlignment="Center" Margin="0,5"/>
                    <ComboBox Grid.Row="2" Grid.Column="1"
                              ItemsSource="{Binding ProfilBreiten}"
                              Text="{Binding SelectedProfilBreite, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True" Margin="0,5"
                              Foreground="Black" Background="White" BorderBrush="#AAAAAA"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Wandstärke (mm):" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Grid.Row="3" Grid.Column="1"
                             Text="{Binding SelectedProfilWand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,5"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Länge (mm):" VerticalAlignment="Center" Margin="0,5"/>
                    <ComboBox Grid.Row="4" Grid.Column="1"
                              ItemsSource="{Binding StandardLaengen}"
                              Text="{Binding SelectedProfilLaenge, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True" Margin="0,5"
                              Foreground="Black" Background="White" BorderBrush="#AAAAAA"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Stückzahl:" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Grid.Row="5" Grid.Column="1"
                             Text="{Binding Stueckzahl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,5"/>
                </Grid>
            </StackPanel>

            <!-- ── Restnummer (manuell) ───────────────────────────────────── -->
            <TextBlock Grid.Row="8" Grid.Column="0" Text="Restnummer:" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox Grid.Row="8" Grid.Column="1"
                     Text="{Binding Restnummer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,5"/>

            <!-- ── Lagerort (manuell) ──────────────────────────────────────── -->
            <TextBlock Grid.Row="9" Grid.Column="0" Text="Lagerort:" VerticalAlignment="Center" Margin="0,5"/>
            <ComboBox Grid.Row="9" Grid.Column="1"
                      ItemsSource="{Binding AvailableLagerorte}"
                      SelectedItem="{Binding SelectedLagerort, Mode=TwoWay}"
                      IsEditable="True" Margin="0,5"
                      Foreground="Black" Background="White" BorderBrush="#AAAAAA"/>

            <!-- ── Datum ───────────────────────────────────────────────────── -->
            <TextBlock Grid.Row="10" Grid.Column="0" Text="{Binding DatumLabel}" VerticalAlignment="Center" Margin="0,5"/>
            <DatePicker Grid.Row="10" Grid.Column="1"
                        SelectedDate="{Binding SelectedDatum, Mode=TwoWay}"
                        Margin="0,5"
                        Background="White"
                        Foreground="Black"
                        BorderBrush="#AAAAAA"/>

            <!-- ── Lieferant / Lieferschein ────────────────────────────────── -->
            <TextBlock Grid.Row="11" Grid.Column="0" Text="Lieferant:" VerticalAlignment="Center" Margin="0,5"
                       Visibility="{Binding LieferantVisible}"/>
            <StackPanel Grid.Row="11" Grid.Column="1" Visibility="{Binding LieferantVisible}">
                <TextBox Text="{Binding SelectedLieferant, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,5"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Lieferschein-Nr:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding SelectedLieferscheinNr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                </StackPanel>
            </StackPanel>

            <!-- ── Preis / Wert ────────────────────────────────────────────── -->
            <TextBlock Grid.Row="12" Grid.Column="0" Text="Preis (€/kg):" VerticalAlignment="Center" Margin="0,5"/>
            <StackPanel Grid.Row="12" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
                <TextBox Text="{Binding PreisProKg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80"
                         Background="White" Foreground="Black" BorderBrush="#AAAAAA" Padding="4"/>
                <TextBlock Text="€/kg" Foreground="#555555" VerticalAlignment="Center" Margin="4,0,8,0"/>
                <TextBlock Text="{Binding GeschaetzterWert}" Foreground="#2E7D32" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- ── Regal-Auslastung (nur Bleche relevant) ─────────────────── -->
            <TextBlock Grid.Row="13" Grid.Column="0" Text="Regal-Auslastung:" VerticalAlignment="Center" Margin="0,5"/>
            <StackPanel Grid.Row="13" Grid.Column="1" Margin="0,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding CurrentLoadKg, StringFormat={}{0:N2} kg}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="/" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding CapacityKg, StringFormat={}{0:N0} kg}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="(" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding UtilizationPercent, StringFormat={}{0:N0}%}" VerticalAlignment="Center"/>
                    <TextBlock Text=")" VerticalAlignment="Center"/>
                    <TextBlock Text="  Gesamt: " VerticalAlignment="Center" Margin="8,0,2,0"/>
                    <TextBlock Text="{Binding TotalInventoryWeight, StringFormat={}{0:N2} kg}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding LengthInfoVisible}" Margin="0,3,0,0">
                    <TextBlock Text="Länge im Lager: " Foreground="#555555"/>
                    <TextBlock Text="{Binding CurrentLoadLengthM, StringFormat={}{0:N2} m}" Foreground="#2E7D32"/>
                    <TextBlock Text="   Gesamt-Länge: " Foreground="#555555" Margin="10,0,0,0"/>
                    <TextBlock Text="{Binding TotalInventoryLengthM, StringFormat={}{0:N2} m}" Foreground="#2E7D32"/>
                </StackPanel>
            </StackPanel>

            <!-- ── Buttons ─────────────────────────────────────────────────── -->
            <StackPanel Grid.Row="14" Grid.ColumnSpan="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="🏷️ Etikett" Width="80" Margin="5" Click="OnEtikett"
                        Visibility="{Binding EtiquetteVisible}" Style="{StaticResource AppButton3DWarningStyle}"/>
                <Button Content="OK (Enter)" Width="100" Margin="5" Click="OnOk"
                        IsDefault="True" IsEnabled="{Binding CanSave}" Style="{StaticResource AppButton3DSuccessStyle}"/>
                <Button Content="Abbrechen" Width="80" Margin="5" Click="OnCancel" IsCancel="True" Style="{StaticResource AppButton3DSecondaryStyle}"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
