<Window x:Class="MaterialManager_V01.Views.StartModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MaterialManager V01 - Start"
        WindowState="Normal"
        Background="#0B0B0B"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        BorderBrush="#2A2A2A"
        BorderThickness="1"
        Icon="/Assets/app-icon.png">
    <Window.Resources>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2E2E2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseTitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Menu">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Icon"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0" ContentSource="Icon" Margin="4,0,6,0" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="20,0,6,0" VerticalAlignment="Center" Foreground="#888"/>
                                <Path Grid.Column="3" x:Name="ArrowPath" Margin="4,0,0,0" VerticalAlignment="Center" Fill="White" Data="M 0 0 L 4 4 L 0 8 Z" Visibility="Collapsed"/>

                                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Right" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" VerticalOffset="-3">
                                    <Border Background="#1A1A1A" BorderBrush="#333" BorderThickness="1" Padding="2">
                                        <ScrollViewer CanContentScroll="True" MaxHeight="400">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="Border" Property="Background" Value="#1F1F1F"/>
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                            </Trigger>
                            <Trigger Property="Role" Value="TopLevelItem">
                                <Setter TargetName="Border" Property="Background" Value="#1F1F1F"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="ArrowPath" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="4,2"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#111111" Height="32" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="/Assets/app-icon.png" Width="18" Height="18" Margin="8,0,10,0" VerticalAlignment="Center"/>

                <Menu Grid.Column="1" VerticalAlignment="Center" FontSize="13">
                    <MenuItem Header="Datei">
                        <MenuItem Header="Hauptprogramm" Click="OnStandardClick"/>
                        <MenuItem Header="Lager" Click="OnLagerClick"/>
                        <MenuItem Header="Tafelplanung" Click="OnTafelplanungClick"/>
                        <MenuItem Header="Laser" Click="OnLaserClick"/>
                        <MenuItem Header="Kantbank" Click="OnKantbankClick"/>
                        <MenuItem Header="Kunden Material" Click="OnKundenMaterialClick"/>
                        <Separator/>
                        <MenuItem Header="Update-Prozesse bereinigen" Click="OnCleanupUpdateProcessesClick"/>
                        <MenuItem Header="Netzwerkordner öffnen" Click="OnOpenNetworkFolder"/>
                        <Separator/>
                        <MenuItem Header="Beenden" Click="OnCloseClick"/>
                    </MenuItem>
                    <MenuItem Header="Bearbeiten">
                        <MenuItem Header="Bediener auswählen" Click="OnSelectOperatorClick"/>
                    </MenuItem>
                    <MenuItem Header="Ansicht">
                        <MenuItem Header="Startseite" IsEnabled="False"/>
                    </MenuItem>
                    <MenuItem Header="Hilfe">
                        <MenuItem Header="Programm- &amp; Netzwerkanleitung" Click="OnProgrammHilfe"/>
                        <MenuItem Header="Nach Updates suchen" Click="OnCheckForUpdates"/>
                    </MenuItem>
                </Menu>

                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource TitleBarButtonStyle}" Content="—" Click="OnMinimizeWindow"/>
                    <Button Style="{StaticResource TitleBarButtonStyle}" Content="▢" Click="OnMaximizeRestoreWindow"/>
                    <Button Style="{StaticResource CloseTitleBarButtonStyle}" Content="✕" Click="OnCloseWindow"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Image Source="/Assets/logo.png"
                   Opacity="0.18"
                   Stretch="Uniform"
                   Width="820"
                   Height="820"
                   IsHitTestVisible="False"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

            <StackPanel Grid.Row="1" Margin="0,0,0,48">
                <Image Source="/Assets/logo.png"
                       Width="220"
                       Height="70"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>
                <TextBlock Text="MaterialManager V01" Foreground="White" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Bitte Bereich auswählen" Foreground="#AAAAAA" FontSize="14" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>

            <UniformGrid Grid.Row="2" Columns="6" Margin="48,0">
                <Button Click="OnStandardClick" Margin="0,0,8,0" Height="150" Background="#1976D2" Foreground="White" Cursor="Hand" BorderThickness="0">
                    <StackPanel>
                        <TextBlock Text="🏠" FontSize="40" HorizontalAlignment="Center"/>
                        <TextBlock Text="Hauptprogramm" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="OnLagerClick" Margin="4,0,4,0" Height="150" Background="#6A1B9A" Foreground="White" Cursor="Hand" BorderThickness="0">
                    <StackPanel>
                        <TextBlock Text="📦" FontSize="40" HorizontalAlignment="Center"/>
                        <TextBlock Text="Lager" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Button>
                <Button Click="OnTafelplanungClick" Margin="4,0,4,0" Height="150" Background="#00897B" Foreground="White" Cursor="Hand" BorderThickness="0">
                    <StackPanel>
                        <TextBlock Text="📋" FontSize="40" HorizontalAlignment="Center"/>
                        <TextBlock Text="Tafelplanung" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Button>
                <Button Click="OnLaserClick" Margin="4,0,4,0" Height="150" Background="#2E7D32" Foreground="White" Cursor="Hand" BorderThickness="0">
                    <StackPanel>
                        <TextBlock Text="⚡" FontSize="40" HorizontalAlignment="Center"/>
                        <TextBlock Text="Laser" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Button>
                <Button Click="OnKantbankClick" Margin="4,0,4,0" Height="150" Background="#23A455" Foreground="White" Cursor="Hand" BorderThickness="0">
                    <StackPanel>
                        <TextBlock Text="🛠" FontSize="40" HorizontalAlignment="Center"/>
                        <TextBlock Text="Kantbank" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Button>
                <Button Click="OnKundenMaterialClick" Margin="8,0,0,0" Height="150" Background="#455A64" Foreground="White" Cursor="Hand" BorderThickness="0">
                    <StackPanel>
                        <TextBlock Text="🧾" FontSize="40" HorizontalAlignment="Center"/>
                        <TextBlock Text="Kunden Material" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <TextBlock Grid.Row="3"
                       Text="Lager: Wareneingang, Regalauslastung, Inventur   |   Tafelplanung: Restmaterial reservieren   |   Laser: Reservierungen einsehen und bearbeiten   |   Kantbank: Kantaufträge nach Reihenfolge bearbeiten   |   Hauptprogramm: Volle Verwaltung"
                       Foreground="#555"
                       FontSize="11"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="48,24,48,0"/>
        </Grid>
    </DockPanel>
</Window>