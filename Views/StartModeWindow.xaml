<Window x:Class="MaterialManager_V01.Views.StartModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MaterialManager V01 - Start"
        WindowState="Maximized"
        Background="#0B0B0B"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        BorderBrush="#2A2A2A"
        BorderThickness="1"
        Icon="/Assets/app-icon.png">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#111111" Height="44" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="/Assets/app-icon.png" Width="18" Height="18" Margin="12,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="MaterialManager V01 - Start" Foreground="White" VerticalAlignment="Center" FontSize="14"/>
                <Button Grid.Column="2" Content="✕" Click="OnCloseClick" Width="50" Height="36" Margin="0,4,4,4" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="1" Margin="0,0,0,48">
                <TextBlock Text="MaterialManager V01" Foreground="White" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Bitte Bereich auswählen" Foreground="#AAAAAA" FontSize="14" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>

            <UniformGrid Grid.Row="2" Columns="4" Margin="48,0">
                <Button Click="OnStandardClick" Margin="0,0,8,0" Height="150" Background="#1976D2" Foreground="White" Cursor="Hand" BorderThickness="0">
                    <StackPanel>
                        <TextBlock Text="🏠" FontSize="40" HorizontalAlignment="Center"/>
                        <TextBlock Text="Hauptprogramm" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="OnLagerClick" Margin="4,0,4,0" Height="150" Background="#6A1B9A" Foreground="White" Cursor="Hand" BorderThickness="0">
                    <StackPanel>
                        <TextBlock Text="📦" FontSize="40" HorizontalAlignment="Center"/>
                        <TextBlock Text="Lager" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Button>
                <Button Click="OnTafelplanungClick" Margin="4,0,4,0" Height="150" Background="#00897B" Foreground="White" Cursor="Hand" BorderThickness="0">
                    <StackPanel>
                        <TextBlock Text="📋" FontSize="40" HorizontalAlignment="Center"/>
                        <TextBlock Text="Tafelplanung" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Button>
                <Button Click="OnLaserClick" Margin="8,0,0,0" Height="150" Background="#2E7D32" Foreground="White" Cursor="Hand" BorderThickness="0">
                    <StackPanel>
                        <TextBlock Text="⚡" FontSize="40" HorizontalAlignment="Center"/>
                        <TextBlock Text="Laser" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <TextBlock Grid.Row="3"
                       Text="Lager: Wareneingang, Regalauslastung, Inventur   |   Tafelplanung: Restmaterial reservieren   |   Laser: Reservierungen einsehen und bearbeiten   |   Hauptprogramm: Volle Verwaltung"
                       Foreground="#555"
                       FontSize="11"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="48,24,48,0"/>
        </Grid>
    </DockPanel>
</Window>