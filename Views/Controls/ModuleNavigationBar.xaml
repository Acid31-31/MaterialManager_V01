<UserControl x:Class="MaterialManager_V01.Views.Controls.ModuleNavigationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MaterialManager_V01.Views.Controls">
    <Border Style="{StaticResource ModuleNavBarBorderStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding ModuleTitle, RelativeSource={RelativeSource AncestorType=controls:ModuleNavigationBar}}"
                       FontSize="17"
                       FontWeight="Bold"
                       Foreground="#B0BEC5"
                       VerticalAlignment="Center"/>

            <controls:ModuleNavigationButtons Grid.Column="1"
                                                ShowHauptprogramm="{Binding ShowHauptprogramm, RelativeSource={RelativeSource AncestorType=controls:ModuleNavigationBar}}"
                                                StartseiteClick="OnStartseiteClick"
                                                HauptprogrammClick="OnHauptprogrammClick"/>
        </Grid>
    </Border>
</UserControl>
