<UserControl x:Class="MaterialManager_V01.Views.Controls.ModuleNavigationButtons"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal">
        <Button x:Name="StartseiteButton"
                Style="{StaticResource ModuleNavStartButtonStyle}"
                ContentTemplate="{StaticResource ModuleNavStartButtonContentTemplate}"
                Click="OnStartseiteClick"/>
        <Button x:Name="HauptprogrammButton"
                Style="{StaticResource ModuleNavMainButtonStyle}"
                ContentTemplate="{StaticResource ModuleNavMainButtonContentTemplate}"
                Click="OnHauptprogrammClick"/>
    </StackPanel>
</UserControl>
