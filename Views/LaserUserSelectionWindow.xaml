<Window x:Class="MaterialManager_V01.Views.LaserUserSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Name eingeben"
        Height="340"
        Width="460"
        Background="{DynamicResource ThemeWindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        BorderBrush="{DynamicResource ThemeBorderBrush}"
        BorderThickness="1"
        Icon="/Assets/app-icon.png">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0F5AA6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource ThemeSurfaceBrush}" Height="36" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="/Assets/app-icon.png" Width="16" Height="16" Margin="10,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Name eingeben" Foreground="{DynamicResource ThemeForegroundBrush}" VerticalAlignment="Center" FontSize="13"/>
                <Button Grid.Column="2" Content="✕" Click="OnWindowCloseClick" Width="46" MinHeight="30" Margin="0,3,3,3" Style="{StaticResource AppButton3DCloseTitleBarStyle}"/>
            </Grid>
        </Border>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Anmeldung" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="22" FontWeight="Bold"/>
            <TextBlock Grid.Row="1" Text="Name eingeben oder aus letzter Liste auswählen" Foreground="#AAAAAA" Margin="0,6,0,18"/>

            <TextBlock Grid.Row="2" Text="Name" Foreground="{DynamicResource ThemeForegroundBrush}" Margin="0,0,0,6"/>
            <TextBox x:Name="NameTextBox"
                     Grid.Row="3"
                     Background="{DynamicResource ThemeSurfaceBrush}"
                     Foreground="{DynamicResource ThemeForegroundBrush}"
                     BorderBrush="{DynamicResource ThemeBorderBrush}"
                     Padding="10,8"
                     Height="38"/>

            <ListBox x:Name="RecentNamesList"
                     Grid.Row="4"
                     Margin="0,12,0,16"
                     MaxHeight="120"
                     MouseDoubleClick="OnRecentNameDoubleClick"/>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Namen löschen"
                        Click="OnDeleteNameClick"
                        Style="{StaticResource AppButton3DDangerStyle}"
                        Padding="12,8"
                        Margin="0,0,8,0"/>
                <Button Content="Abbrechen"
                        Click="OnCancelClick"
                        Style="{StaticResource AppButton3DSecondaryStyle}"
                        Padding="12,8"
                        Margin="0,0,8,0"/>
                <Button Content="OK"
                        Click="OnOkClick"
                        Style="{StaticResource AppButton3DPrimaryStyle}"
                        Padding="18,8"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>