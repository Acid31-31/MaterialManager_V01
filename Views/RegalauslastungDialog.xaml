<Window x:Class="MaterialManager_V01.Views.RegalauslastungDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📦 Regalauslastung im Detail" 
        Height="650" Width="800" 
        Background="{DynamicResource ThemeWindowBackgroundBrush}"
        Foreground="{DynamicResource ThemeForegroundBrush}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize">
    
    <Window.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource AppDialogTextBlockStyle}"/>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Background="{DynamicResource ThemeWindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource ThemeSurfaceBrush}" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="📦 Regalauslastung im Detail" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold"/>
                    <Button Grid.Column="1" Style="{StaticResource TitleBarButtonStyle}" Content="✕" Click="OnCloseWindowClick"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{DynamicResource ThemeAltSurfaceBrush}" Padding="25" CornerRadius="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="📦 Regalauslastung - Übersicht" 
                               FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ThemeForegroundBrush}" 
                               Margin="0,0,0,20" HorizontalAlignment="Center"/>
                    
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button Content="Aktualisieren" Click="OnRefresh" Width="120" MinHeight="35" 
                                Style="{StaticResource AppButton3DPrimaryStyle}" FontSize="14" Cursor="Hand" Margin="0,0,10,0"/>
                        <Button Content="Schließen" Click="OnClose" Width="120" MinHeight="35" 
                                Style="{StaticResource AppButton3DSecondaryStyle}" FontSize="14" Cursor="Hand"/>
                    </StackPanel>
                    
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="RegalPanel">
                            <!-- Regale werden dynamisch hinzugefügt -->
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
