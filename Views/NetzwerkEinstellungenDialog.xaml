<Window x:Class="MaterialManager_V01.Views.NetzwerkEinstellungenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Netzwerk-Einstellungen"
        Height="1040"
        Width="1240"
        Background="{DynamicResource ThemeWindowBackgroundBrush}"
        Foreground="{DynamicResource ThemeForegroundBrush}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#222" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1976D2" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Margin" Value="0,6" />
        </Style>
</Window.Resources>

    <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Background="{DynamicResource ThemeWindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource ThemeSurfaceBrush}" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Netzwerk-Einstellungen" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold" FontSize="16"/>
                    <Button Grid.Column="1" Style="{StaticResource TitleBarButtonStyle}" Content="✕" Click="OnCloseWindowClick"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="16,12,16,8">
                <StackPanel>
                    <TextBlock Text="Netzwerk-Modus" FontSize="26" FontWeight="Bold" Margin="0,0,0,6"/>
                    <CheckBox x:Name="AktivCheck" Content="Netzwerk-Modus aktivieren" FontSize="17" />

                    <TextBlock Text="Gemeinsamer Netzwerkpfad (Materialdaten):" Margin="0,8,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PfadBox" Grid.Column="0" HorizontalScrollBarVisibility="Auto" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Durchsuchen" Width="120" MinHeight="40" Click="OnBrowsePfad"/>
                        <Button Grid.Column="2" Content="Öffnen" Width="90" MinHeight="40" Click="OnOpenPfad"/>
                    </Grid>

                    <TextBlock Text="Gemeinsamer Auftrags-Archivpfad (Laser/Auftragssteuerung):" Margin="0,10,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ArchivPfadBox" Grid.Column="0" HorizontalScrollBarVisibility="Auto" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Durchsuchen" Width="120" MinHeight="40" Click="OnBrowseArchivPfad"/>
                        <Button Grid.Column="2" Content="Öffnen" Width="90" MinHeight="40" Click="OnOpenArchivPfad"/>
                    </Grid>

                    <TextBlock Foreground="#A0A0A0" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Pfad muss auf allen Rechnern identisch sein (z.B. \\SERVER\MaterialManager\Auftragsarchiv oder Z:\Auftragsarchiv)."/>

                    <TextBlock Text="Benutzername (optional):" Margin="0,10,0,4" />
                    <TextBox x:Name="BenutzerBox" />

                    <Border Background="{DynamicResource ThemeAltSurfaceBrush}" BorderBrush="#2E2E2E" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,12,0,0">
                        <TextBlock TextWrapping="Wrap" Foreground="#D0D0D0">
                            So erstellen Sie den gemeinsamen Archivordner:
                            &#x0a;1) Auf Server/NAS einen Ordner anlegen (z.B. Auftragsarchiv).
                            &#x0a;2) Freigabe aktivieren und allen beteiligten Rechnern Lese-/Schreibrechte geben.
                            &#x0a;3) Auf jedem PC denselben UNC-Pfad oder denselben Laufwerksbuchstaben verwenden.
                            &#x0a;4) Hier exakt denselben Pfad auf allen PCs eintragen.
                        </TextBlock>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,12,12">
                <Button Content="Speichern" Click="OnSave" Width="100" />
                <Button Content="Abbrechen" Click="OnCancel" Width="100" Style="{StaticResource AppButton3DSecondaryStyle}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
