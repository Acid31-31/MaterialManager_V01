<Window x:Class="MaterialManager_V01.Views.RohrZuschnittDialog"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:controls="clr-namespace:MaterialManager_V01.Views.Controls"
		Title="Rohrezuschnitt optimieren"
		WindowStartupLocation="CenterScreen"
		WindowState="Maximized"
		Background="#0F0F0F"
		Foreground="White">
	<Window.Resources>
		<Style TargetType="TextBlock">
			<Setter Property="Foreground" Value="White"/>
		</Style>
		<Style TargetType="Label">
			<Setter Property="Foreground" Value="White"/>
		</Style>

		<!-- TextBox mit eigenem ControlTemplate für zuverlässiges Dunkelmodus-Design -->
		<Style TargetType="TextBox">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Background" Value="#232323"/>
			<Setter Property="CaretBrush" Value="White"/>
			<Setter Property="BorderBrush" Value="#3A3A3A"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="SelectionBrush" Value="#2E7D32"/>
			<Setter Property="Padding" Value="8,4"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Border x:Name="bd"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="3">
							<ScrollViewer x:Name="PART_ContentHost"
										  Margin="{TemplateBinding Padding}"
										  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
										  HorizontalScrollBarVisibility="Hidden"
										  VerticalScrollBarVisibility="Hidden"
										  Focusable="False"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="BorderBrush" Value="#555"/>
							</Trigger>
							<Trigger Property="IsFocused" Value="True">
								<Setter TargetName="bd" Property="BorderBrush" Value="#00897B"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- ComboBox mit eigenem ControlTemplate für zuverlässiges Dunkelmodus-Design -->
		<Style TargetType="ComboBox">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Background" Value="#232323"/>
			<Setter Property="BorderBrush" Value="#3A3A3A"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="8,0,4,0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ComboBox">
						<Grid>
							<Border x:Name="bd"
									Background="{TemplateBinding Background}"
									BorderBrush="{TemplateBinding BorderBrush}"
									BorderThickness="{TemplateBinding BorderThickness}"
									CornerRadius="3"/>
							<ContentPresenter x:Name="contentPresenter"
											  Margin="{TemplateBinding Padding}"
											  Content="{TemplateBinding SelectionBoxItem}"
											  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
											  HorizontalAlignment="Left"
											  VerticalAlignment="Center"
											  IsHitTestVisible="False"/>
							<ToggleButton Background="Transparent"
										  BorderThickness="0"
										  Focusable="False"
										  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
										  ClickMode="Press">
								<ToggleButton.Template>
									<ControlTemplate TargetType="ToggleButton">
										<Grid Background="Transparent">
											<Grid.ColumnDefinitions>
												<ColumnDefinition/>
												<ColumnDefinition Width="24"/>
											</Grid.ColumnDefinitions>
											<Path Grid.Column="1"
												  Data="M 0 0 L 5 5 L 10 0 Z"
												  Fill="#AAAAAA"
												  HorizontalAlignment="Center"
												  VerticalAlignment="Center"/>
										</Grid>
									</ControlTemplate>
								</ToggleButton.Template>
							</ToggleButton>
							<Popup x:Name="PART_Popup"
								   IsOpen="{TemplateBinding IsDropDownOpen}"
								   Placement="Bottom"
								   AllowsTransparency="True"
								   Focusable="False"
								   PopupAnimation="Slide">
								<Border Background="#232323"
										BorderBrush="#3A3A3A"
										BorderThickness="1"
										MinWidth="{TemplateBinding ActualWidth}"
										MaxHeight="{TemplateBinding MaxDropDownHeight}">
									<ScrollViewer>
										<ItemsPresenter/>
									</ScrollViewer>
								</Border>
							</Popup>
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="BorderBrush" Value="#555"/>
							</Trigger>
							<Trigger Property="IsDropDownOpen" Value="True">
								<Setter TargetName="bd" Property="BorderBrush" Value="#00897B"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style TargetType="ComboBoxItem">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Background" Value="#232323"/>
			<Setter Property="Padding" Value="8,6"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ComboBoxItem">
						<Border x:Name="bd"
								Background="{TemplateBinding Background}"
								Padding="{TemplateBinding Padding}">
							<ContentPresenter/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#2A2A2A"/>
							</Trigger>
							<Trigger Property="IsSelected" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#00695C"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style TargetType="Button">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Background" Value="#2A2A2A"/>
			<Setter Property="BorderBrush" Value="#444"/>
			<Setter Property="Padding" Value="10,5"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bd"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								Padding="{TemplateBinding Padding}"
								CornerRadius="3">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="Opacity" Value="0.85"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="bd" Property="Opacity" Value="0.7"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style TargetType="DataGrid">
			<Setter Property="Background" Value="#141414"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="RowBackground" Value="#1B1B1B"/>
			<Setter Property="AlternatingRowBackground" Value="#171717"/>
			<Setter Property="GridLinesVisibility" Value="None"/>
			<Setter Property="BorderBrush" Value="#2C2C2C"/>
		</Style>
		<Style TargetType="DataGridColumnHeader">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Background" Value="#202020"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Padding" Value="8,6"/>
		</Style>
		<Style TargetType="DataGridCell">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Background" Value="#1B1B1B"/>
			<Setter Property="BorderBrush" Value="#2C2C2C"/>
		</Style>
	</Window.Resources>

	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- ═══ NAVIGATION ═══ -->
		<controls:ModuleNavigationBar Grid.Row="0"
									  ModuleTitle="Rohrezuschnitt"
									  StartseiteClick="OnZurStartseiteClick"
									  HauptprogrammClick="OnZurHauptprogrammClick"
									  Margin="0,0,0,10"/>

		<!-- ═══ EINGABEBEREICH ═══ -->
		<Border Grid.Row="1" Background="#181818" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,10">
			<StackPanel>
				<TextBlock Text="Neues Rohr erfassen" FontSize="14" FontWeight="Bold"
						   Foreground="#00BFA5" Margin="0,0,0,12"/>

					<!-- Zeile 1: Bezeichnung | Länge | Menge | Winkel Links | Winkel Rechts -->
				<Grid Margin="0,0,0,10">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="2.5*"/>
						<ColumnDefinition Width="16"/>
						<ColumnDefinition Width="1.2*"/>
						<ColumnDefinition Width="16"/>
						<ColumnDefinition Width="0.8*"/>
						<ColumnDefinition Width="16"/>
						<ColumnDefinition Width="0.9*"/>
						<ColumnDefinition Width="16"/>
						<ColumnDefinition Width="0.9*"/>
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Column="0">
						<TextBlock Text="Rohrbezeichnung (manuell eingeben)" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,4"/>
						<TextBox x:Name="BezeichnungTextBox" Height="36"/>
					</StackPanel>

					<StackPanel Grid.Column="2">
						<TextBlock Text="Länge (mm)" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,4"/>
						<TextBox x:Name="PositionLaengeTextBox" Height="36" Text="1000"/>
					</StackPanel>

					<StackPanel Grid.Column="4">
						<TextBlock Text="Menge" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,4"/>
						<TextBox x:Name="PositionMengeTextBox" Height="36" Text="1"/>
					</StackPanel>

					<StackPanel Grid.Column="6">
						<TextBlock FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,4">
							<Run Text="Winkel links (°)"/>
							<Run Text=" z.B. 45" Foreground="#555"/>
						</TextBlock>
						<TextBox x:Name="WinkelLinksTextBox" Height="36" Text="90"
								 ToolTip="Schnittwinkel linkes Ende in Grad (1–89 = Gehrung, 90 = gerade)"/>
					</StackPanel>

					<StackPanel Grid.Column="8">
						<TextBlock FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,4">
							<Run Text="Winkel rechts (°)"/>
							<Run Text=" z.B. 65" Foreground="#555"/>
						</TextBlock>
						<TextBox x:Name="WinkelRechtsTextBox" Height="36" Text="90"
								 ToolTip="Schnittwinkel rechtes Ende in Grad (1–89 = Gehrung, 90 = gerade)"/>
					</StackPanel>
				</Grid>

				<!-- Zeile 2: Zeichnung aus Liste | Stangenlänge | Schnittverlust -->
				<Grid Margin="0,0,0,10">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="2.5*"/>
						<ColumnDefinition Width="16"/>
						<ColumnDefinition Width="1.2*"/>
						<ColumnDefinition Width="16"/>
						<ColumnDefinition Width="0.8*"/>
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Column="0">
						<TextBlock Text="Zeichnung / PDF aus Lager-Liste (optional)" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,4"/>
						<ComboBox x:Name="ZeichnungComboBox" Height="36"
								  SelectionChanged="OnZeichnungSelectionChanged"/>
					</StackPanel>

					<StackPanel Grid.Column="2">
						<TextBlock Text="Stangenlänge (mm)" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,4"/>
						<TextBox x:Name="StangenLaengeTextBox" Height="36" Text="6000"/>
					</StackPanel>

					<StackPanel Grid.Column="4">
						<TextBlock Text="Schnittverlust (mm)" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,4"/>
						<TextBox x:Name="SchnittverlustTextBox" Height="36" Text="3"/>
					</StackPanel>
				</Grid>

				<!-- Zeile 3: PDF Drop-Zone + Rohr hinzufügen -->
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="16"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<!-- PDF Drop-Zone -->
					<Border x:Name="PdfDropBorder"
							Grid.Column="0"
							Background="#111111"
							BorderBrush="#3A3A3A"
							BorderThickness="2"
							CornerRadius="6"
							Padding="14,10"
							AllowDrop="True"
							DragEnter="OnPdfDragEnter"
							DragLeave="OnPdfDragLeave"
							DragOver="OnPdfDragOver"
							Drop="OnPdfDrop">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="10"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="📄" FontSize="22" VerticalAlignment="Center" Foreground="#555555"/>
							<TextBlock x:Name="AusgewaehltePdfTextBlock"
									   Grid.Column="2"
									   Text="PDF hier reinziehen  (aus Explorer oder Ordner)"
									   Foreground="#666666"
									   FontSize="13"
									   FontStyle="Italic"
									   VerticalAlignment="Center"
									   TextTrimming="CharacterEllipsis"/>
						</Grid>
					</Border>

					<!-- Rohr hinzufügen -->
					<Button Grid.Column="2"
							Content="✚  Rohr hinzufügen"
							Height="46"
							Width="160"
							Style="{StaticResource AppButton3DTealStyle}"
							FontSize="13"
							Click="OnRohrHinzufuegen"/>
				</Grid>
			</StackPanel>
		</Border>

		<!-- ═══ STATUS-ZEILE ═══ -->
		<Border Grid.Row="2" Background="#161616" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
			<TextBlock x:Name="ZusammenfassungTextBlock"
					   Text="Rohre manuell eingeben und mit '✚ Rohr hinzufügen' zur Liste hinzufügen. PDF ist optional."
					   Foreground="#888888"
					   FontSize="12"
					   TextWrapping="Wrap"/>
		</Border>

		<!-- ═══ ROHRLISTE ═══ -->
		<Border Grid.Row="3" Background="#141414" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="0">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>
				<Border Grid.Row="0" Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="0,0,0,1" Padding="12,8" CornerRadius="8,8,0,0">
					<TextBlock Text="Erfasste Rohre" FontWeight="SemiBold" Foreground="#CCCCCC" FontSize="13"/>
				</Border>
				<DataGrid Grid.Row="1"
						  x:Name="PositionenGrid"
						  AutoGenerateColumns="False"
						  CanUserAddRows="False"
						  IsReadOnly="True"
						  HeadersVisibility="Column"
						  Margin="0">
					<DataGrid.Columns>
						<DataGridTextColumn Header="Rohrbezeichnung" Binding="{Binding Bezeichnung}" Width="2*"/>
						<DataGridTextColumn Header="Länge (mm)" Binding="{Binding LaengeMm, StringFormat={}{0:N0}}" Width="110"/>
						<DataGridTextColumn Header="Menge" Binding="{Binding Menge}" Width="70"/>
						<DataGridTextColumn Header="Winkel L/R" Binding="{Binding WinkelText}" Width="100"/>
						<DataGridTextColumn Header="PDF-Datei" Binding="{Binding PdfAnzeige}" Width="2*"/>
						<DataGridTemplateColumn Header="PDF (Drop)" Width="110">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Border Background="#1A1A1A"
											BorderBrush="#3A3A3A"
											BorderThickness="1"
											CornerRadius="3"
											Padding="4,3"
											AllowDrop="True"
											ToolTip="PDF hier reinziehen"
											Tag="{Binding}"
											DragOver="OnPdfDragOver"
											Drop="OnPdfZuPositionDrop">
										<TextBlock Text="📄 Drop"
												   FontSize="11"
												   Foreground="#777"
												   HorizontalAlignment="Center"/>
									</Border>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTemplateColumn Header="Löschen" Width="80">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Button Content="✖"
											Width="38"
											Height="26"
											Style="{StaticResource AppButton3DCompactDangerStyle}"
											Padding="4,2"
											Tag="{Binding}"
											ToolTip="Position entfernen"
											Click="OnPositionLoeschen"/>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>
			</Grid>
		</Border>

		<!-- ═══ AKTIONEN ═══ -->
		<Grid Grid.Row="4" Margin="0,10,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			<TextBlock Grid.Column="0"
					   Text="Tipp: Bezeichnung eingeben → PDF reinziehen (Länge + Menge werden auto-befüllt) → prüfen → Rohr hinzufügen → Berechnen"
					   Foreground="#555" FontSize="11" VerticalAlignment="Center"/>
			<Button Grid.Column="1"
					Content="⚙  Berechnen"
					Width="140"
					Height="36"
					Style="{StaticResource AppButton3DSuccessStyle}"
					FontSize="13"
					Click="OnBerechnen"/>
		</Grid>
	</Grid>
</Window>


