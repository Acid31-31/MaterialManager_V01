<Window x:Class="MaterialManager_V01.Views.KundenMaterialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MaterialManager_V01.Views.Controls"
        Title="Kunden Material"
        Height="760"
        Width="1200"
        MinHeight="560"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        BorderBrush="#2A2A2A"
        BorderThickness="1"
        Background="#0B0B0B"
        Icon="/Assets/app-icon.png">
    <Window.Resources>
<Style TargetType="Menu">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Icon"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0" ContentSource="Icon" Margin="4,0,6,0" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="20,0,6,0" VerticalAlignment="Center" Foreground="#888"/>
                                <Path Grid.Column="3" x:Name="ArrowPath" Margin="4,0,0,0" VerticalAlignment="Center" Fill="White" Data="M 0 0 L 4 4 L 0 8 Z" Visibility="Collapsed"/>

                                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Right" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" VerticalOffset="-3">
                                    <Border Background="#1A1A1A" BorderBrush="#333" BorderThickness="1" Padding="2">
                                        <ScrollViewer CanContentScroll="True" MaxHeight="400">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="Border" Property="Background" Value="#1F1F1F"/>
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                            </Trigger>
                            <Trigger Property="Role" Value="TopLevelItem">
                                <Setter TargetName="Border" Property="Background" Value="#1F1F1F"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="ArrowPath" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="4,2"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.ColumnSpan="2" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>

                            <ContentPresenter x:Name="ContentSite"
                                              Grid.Column="0"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>

                            <TextBox x:Name="PART_EditableTextBox"
                                     Grid.Column="0"
                                     Margin="8,0,0,0"
                                     Padding="0"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Left"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{TemplateBinding Foreground}"
                                     FontSize="{TemplateBinding FontSize}"
                                     Visibility="Hidden"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"
                                     Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <ToggleButton Grid.Column="1"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="#111111"
                                          BorderBrush="#444"
                                          BorderThickness="1,0,0,0">
                                <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#1A1A1A" BorderBrush="#444" BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1976D2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#121212"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="RowBackground" Value="#1A1A1A"/>
            <Setter Property="AlternatingRowBackground" Value="#151515"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="BorderBrush" Value="#333"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="#111111" Height="32" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="/Assets/app-icon.png" Width="16" Height="16" Margin="8,0,10,0" VerticalAlignment="Center"/>

                    <Menu Grid.Column="1" VerticalAlignment="Center" FontSize="13">
                        <MenuItem Header="Datei">
                            <MenuItem Header="Aktualisieren" Click="OnRefreshClick"/>
                            <MenuItem Header="Einstellungsdialog öffnen" Click="OnOpenSettingsClick"/>
                            <MenuItem Header="PDF-Root-Ordner wählen" Click="OnChoosePdfFolderClick"/>
                            <MenuItem Header="Excel-Datei wählen" Click="OnChooseImportExcelPathClick"/>
                            <MenuItem Header="Netzwerkordner öffnen" Click="OnOpenNetworkFolder"/>
                            <Separator/>
                            <MenuItem Header="Startseite" Click="OnOpenStartProgramClick"/>
                            <MenuItem Header="Hauptprogramm" Click="OnOpenMainProgramClick"/>
                            <MenuItem Header="Schließen" Click="OnCloseWindow"/>
                        </MenuItem>
                        <MenuItem Header="Hilfe">
                            <MenuItem Header="Programm- &amp; Netzwerkanleitung" Click="OnProgrammHilfe"/>
                            <MenuItem Header="Nach Updates suchen" Click="OnCheckForUpdates"/>
                        </MenuItem>
                    </Menu>

                    <TextBlock x:Name="LicenseBannerTextBlock"
                               Grid.ColumnSpan="4"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               FontSize="14"
                               IsHitTestVisible="False"
                               TextTrimming="CharacterEllipsis"/>

                    <StackPanel Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Right">
                        <TextBlock x:Name="NetworkModeTextBlock"
                                   Foreground="#9E9E9E"
                                   FontSize="10"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,0,2"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="NetworkExcelTextBlock"
                                   Foreground="#9E9E9E"
                                   FontSize="9"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,0,6"
                                   TextTrimming="CharacterEllipsis"/>
                        <controls:ModuleNavigationButtons ShowHauptprogramm="False"
                                                            StartseiteClick="OnOpenStartProgramClick"
                                                            HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Top" Background="#111111" Padding="10" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="/Assets/app-icon.png" Width="16" Height="16" Margin="6,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Kunden Material" Foreground="White" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="Überproduktion für Kundenaufträge erfassen" Foreground="#AAAAAA" Margin="0,6,0,0"/>
                    </StackPanel>

                    <controls:ModuleNavigationButtons Grid.Column="2"
                                                      ShowHauptprogramm="False"
                                                      StartseiteClick="OnOpenStartProgramClick"/>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Top" Background="#1B1B1B" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Zeichnungsnummer:" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" x:Name="DrawingNumberBox" />

                    <TextBlock Grid.Column="2" Text="Stückzahl:" Foreground="White" VerticalAlignment="Center" Margin="12,0,10,0"/>
                    <TextBox Grid.Column="3" x:Name="QuantityBox" Text="1" />

                    <Button Grid.Column="4" Content="PDF suchen" Click="OnSearchPdfClick" Margin="12,0,8,0" Padding="14,6" Style="{StaticResource AppButton3DPrimaryStyle}"/>
                    <Button Grid.Column="5" Content="Excel importieren" Click="OnImportExcelClick" Margin="0,0,8,0" Padding="14,6" Style="{StaticResource AppButton3DInfoStyle}"/>
                    <Button Grid.Column="6" Content="Hinzufügen" Click="OnAddClick" Margin="0,0,8,0" Padding="14,6" Style="{StaticResource AppButton3DSuccessStyle}" HorizontalAlignment="Left"/>
                    <Button Grid.Column="6" Content="Löschen" Click="OnDeleteClick" Padding="14,6" Style="{StaticResource AppButton3DDangerStyle}" HorizontalAlignment="Right"/>

                    <TextBlock Grid.Row="1" Text="PDF-Root-Ordner:" Foreground="White" VerticalAlignment="Center" Margin="0,10,10,0" Visibility="Collapsed"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="PdfFolderBox" Margin="0,10,0,0" Text="" Visibility="Collapsed"/>
                    <Button Grid.Row="1" Grid.Column="4" Content="Pfad wählen" Click="OnChoosePdfFolderClick" Margin="12,10,8,0" Padding="14,6" Style="{StaticResource AppButton3DInfoStyle}" Visibility="Collapsed"/>
                    <TextBlock Grid.Row="1" Grid.Column="5" Grid.ColumnSpan="2" x:Name="FoundPdfText" Margin="0,10,0,0" Foreground="#AAAAAA" VerticalAlignment="Center" Text="Keine PDF gesucht." Visibility="Collapsed"/>

                    <TextBlock Grid.Row="2" Text="Excel-Datei:" Foreground="White" VerticalAlignment="Center" Margin="0,10,10,0" Visibility="Collapsed"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="ImportExcelPathBox" Margin="0,10,0,0" IsReadOnly="True" Visibility="Collapsed"/>
                    <Button Grid.Row="2" Grid.Column="4" Content="Excel wählen" Click="OnChooseImportExcelPathClick" Margin="12,10,8,0" Padding="14,6" Style="{StaticResource AppButton3DInfoStyle}" Visibility="Collapsed"/>
                    <Button Grid.Row="2" Grid.Column="5" Content="Import starten" Click="OnImportExcelClick" Margin="0,10,8,0" Padding="14,6" Style="{StaticResource AppButton3DInfoStyle}" Visibility="Collapsed"/>
                    <TextBlock Grid.Row="2" Grid.Column="6" x:Name="ImportExcelInfoText" Margin="0,10,0,0" Foreground="#AAAAAA" VerticalAlignment="Center" Text="Keine Excel ausgewählt." Visibility="Collapsed"/>

                    <TextBlock Grid.Row="3" Text="Kunde:" Foreground="White" VerticalAlignment="Center" Margin="0,10,10,0"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="CustomerBox" Margin="0,10,0,0" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" SelectionChanged="OnCustomerSelectionChanged" LostFocus="OnCustomerSelectionLostFocus"/>
                    <Button Grid.Row="3" Grid.Column="4" Content="Kundenordner wählen" Click="OnChooseCustomerFolderClick" Margin="12,10,8,0" Padding="14,6" Style="{StaticResource AppButton3DInfoStyle}"/>
                    <TextBlock Grid.Row="3" Grid.Column="5" Grid.ColumnSpan="2" x:Name="CustomerFolderHintText" Margin="0,10,0,0" Foreground="#AAAAAA" VerticalAlignment="Center" Text="Suche: Root\Kunde\Freigabe"/>
                </Grid>
            </Border>

            <DataGrid x:Name="KundenMaterialGrid"
                      ItemsSource="{Binding Items}"
                      AutoGenerateColumns="False"
                      Margin="10"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      IsReadOnly="True"
                      MouseDoubleClick="OnGridMouseDoubleClick"
                      RowHeight="30">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Kunde" Binding="{Binding Kunde}" Width="180"/>
                    <DataGridTextColumn Header="Zeichnungsnummer" Binding="{Binding Zeichnungsnummer}" Width="*"/>
                    <DataGridTextColumn Header="Stückzahl" Binding="{Binding Stueckzahl}" Width="120"/>
                    <DataGridTextColumn Header="PDF" Binding="{Binding PdfDateiname}" Width="260"/>
                    <DataGridTextColumn Header="Erfasst am" Binding="{Binding ErstelltAm, StringFormat=dd.MM.yyyy HH:mm}" Width="180"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</Window>