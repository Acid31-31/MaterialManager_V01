<Window x:Class="MaterialManager_V01.Views.LicenseActivationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lizenz aktivieren - MaterialManager V01" 
        Height="1050" Width="1330" 
        WindowStartupLocation="CenterScreen"
        Background="#0B0B0B"
        ResizeMode="NoResize">

    <Window.Resources>
        <SolidColorBrush x:Key="HerkoGreen" Color="#23A455"/>
        <SolidColorBrush x:Key="HerkoGreenSoft" Color="#66BB6A"/>
        <SolidColorBrush x:Key="HerkoGreenLight" Color="#8FD19E"/>
        <SolidColorBrush x:Key="HerkoGreenDark" Color="#1F8E4A"/>
    </Window.Resources>
    
    <Border Padding="20" Background="#121212">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Lizenzaktivierung" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="{StaticResource HerkoGreen}"
                           Margin="0,0,0,10"/>
                <TextBlock Text="Aktivieren Sie Ihre Jahreslizenz für MaterialManager V01" 
                           FontSize="14" 
                           Foreground="#AAA"/>
                
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="Lizenzmodell" FontSize="14" Foreground="#FFD700" Margin="0,0,8,0"/>
                        <TextBlock Text="Industrie-Edition" Foreground="{StaticResource HerkoGreen}" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <TextBlock Grid.Column="1" Text="{Binding HeadlinePriceText}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource HerkoGreen}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                
                <Border Background="#1E1E1E" 
                        CornerRadius="5" 
                        Padding="15" 
                        Margin="0,15,0,0">
                    <StackPanel>
                        <TextBlock Text="© 2025 Alexander Hölzer - Alle Rechte vorbehalten" 
                                   Foreground="White" 
                                   FontWeight="Bold"
                                   TextAlignment="Center"/>
                        <TextBlock Text="Urheberrechtlich geschützt gemäß §§ 69a ff. UrhG" 
                                   Foreground="#888" 
                                   FontSize="11"
                                   TextAlignment="Center"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Hardware-ID Anzeige -->
                    <Border Background="#1E1E1E" 
                            CornerRadius="5" 
                            Padding="15" 
                            Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="1️⃣ Ihre Hardware-ID" 
                                       FontSize="16" 
                                       FontWeight="Bold" 
                                       Foreground="White"
                                       Margin="0,0,0,10"/>
                            <TextBlock Text="Geben Sie diese ID beim Lizenzkauf an:" 
                                       Foreground="#AAA" 
                                       FontSize="12"
                                       Margin="0,0,0,8"/>
                            <Border Background="#0F0F0F" 
                                    BorderBrush="#333" 
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="10">
                                <Grid>
                                    <TextBox x:Name="HardwareIdTextBox"
                                             Text="{Binding HardwareId, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Background="Transparent"
                                             Foreground="{StaticResource HerkoGreen}"
                                             BorderThickness="0"
                                             FontFamily="Consolas"
                                             FontSize="14"
                                             FontWeight="Bold"/>
                                    <Button Content="📋 Kopieren"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Background="#333"
                                            Foreground="White"
                                            Padding="10,5"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="OnCopyHardwareId"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Lizenzschlüssel Eingabe -->
                    <Border Background="#1E1E1E" 
                            CornerRadius="5" 
                            Padding="15" 
                            Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="2️⃣ Lizenzschlüssel eingeben" 
                                       FontSize="16" 
                                       FontWeight="Bold" 
                                       Foreground="White"
                                       Margin="0,0,0,10"/>
                            <TextBlock Text="Format: MM-XXXX-XXXX-XXXX-XXXX" 
                                       Foreground="#AAA" 
                                       FontSize="12"
                                       Margin="0,0,0,8"/>
                            <TextBox x:Name="LicenseKeyTextBox"
                                     Background="#0F0F0F"
                                     Foreground="White"
                                     Padding="10"
                                     FontFamily="Consolas"
                                     FontSize="14"
                                     BorderBrush="#333"
                                     BorderThickness="1"
                                     MaxLength="22"
                                     TextChanged="OnLicenseKeyChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- Registrierung -->
                    <Border Background="#1E1E1E" 
                            CornerRadius="5" 
                            Padding="15" 
                            Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="3️⃣ Registrierungsinformationen" 
                                       FontSize="16" 
                                       FontWeight="Bold" 
                                       Foreground="White"
                                       Margin="0,0,0,10"/>
                            <TextBlock Text="Firma / Name:" 
                                       Foreground="#AAA" 
                                       FontSize="12"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="RegisteredToTextBox"
                                     Background="#0F0F0F"
                                     Foreground="White"
                                     Padding="10"
                                     FontSize="13"
                                     BorderBrush="#333"
                                     BorderThickness="1"
                                     MaxLength="100"
                                     TextChanged="OnRegisteredToChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- Lizenztyp-Info mit PREISEN -->
                    <Border Background="#1F1F1F" 
                            BorderBrush="{StaticResource HerkoGreen}" 
                            BorderThickness="2"
                            CornerRadius="5" 
                            Padding="15" 
                            Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Verfügbare Lizenzstufen" 
                                       FontSize="14" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource HerkoGreen}"
                                       Margin="0,0,0,12"/>
                             
                            <Border Background="#2A2A2A" CornerRadius="3" Padding="12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Single (S1)" FontWeight="Bold" Foreground="White" FontSize="12"/>
                                        <TextBlock Text="1 Arbeitsplatz" Foreground="#AAA" FontSize="11" Margin="0,3,0,0"/>
                                        <TextBlock Text="Leistungsumfang: Basisbetrieb, Standard-Updates, E-Mail-Support (werktags, Reaktionszeit bis 48h)" Foreground="{StaticResource HerkoGreenLight}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding SinglePriceText}" FontWeight="Bold" Foreground="{StaticResource HerkoGreen}" FontSize="13"/>
                                        <TextBlock Text="pro Jahr" Foreground="#888" FontSize="10" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            
                            <Border Background="#2A2A2A" CornerRadius="3" Padding="12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Mehrplatz (M3)" FontWeight="Bold" Foreground="White" FontSize="12"/>
                                        <TextBlock Text="3 Arbeitsplätze" Foreground="#AAA" FontSize="11" Margin="0,3,0,0"/>
                                        <TextBlock Text="Leistungsumfang: Teamlizenz, priorisierte Fehlerbehebung, Remote-Support nach Termin (Reaktionszeit bis 24h)" Foreground="{StaticResource HerkoGreenLight}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding MultiPriceText}" FontWeight="Bold" Foreground="{StaticResource HerkoGreenSoft}" FontSize="13"/>
                                        <TextBlock Text="pro Jahr" Foreground="#888" FontSize="10" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            
                            <Border Background="#2A2A2A" CornerRadius="3" Padding="12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Firmenlizenz (C10)" FontWeight="Bold" Foreground="White" FontSize="12"/>
                                        <TextBlock Text="10 Arbeitsplätze inkl. Standard-Support" Foreground="#AAA" FontSize="11" Margin="0,3,0,0"/>
                                        <TextBlock Text="Leistungsumfang: Mehrstandortfähig, SLA-orientierte Reaktionszeit (bis 8h), regelmäßige Versionspflege" Foreground="{StaticResource HerkoGreenLight}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding CompanyPriceText}" FontWeight="Bold" Foreground="{StaticResource HerkoGreenDark}" FontSize="13"/>
                                        <TextBlock Text="pro Jahr" Foreground="#888" FontSize="10" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            
                            <Border Background="#2A2A2A" CornerRadius="3" Padding="12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Enterprise (ENT)" FontWeight="Bold" Foreground="White" FontSize="12"/>
                                        <TextBlock Text="Erweiterbar, priorisierter Support, individuelle Vereinbarung" Foreground="#AAA" FontSize="11" Margin="0,3,0,0"/>
                                        <TextBlock Text="Leistungsumfang: individuelle Betreuung, erweiterte Servicefenster, projektspezifische Anpassungen (Reaktionszeit bis 4h)" Foreground="{StaticResource HerkoGreenLight}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding EnterprisePriceText}" FontWeight="Bold" Foreground="{StaticResource HerkoGreenSoft}" FontSize="13"/>
                                        <TextBlock Text="pro Jahr" Foreground="#888" FontSize="10" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            
                            <!-- Hinweis -->
                            <TextBlock Text="{Binding CalculationHintText}" 
                                       Foreground="{StaticResource HerkoGreen}" 
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,10,0,0"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Kontakt & Support -->
                    <Border Background="#1E1E1E" 
                            BorderBrush="{StaticResource HerkoGreen}"
                            BorderThickness="1"
                            CornerRadius="5" 
                            Padding="15" 
                            Margin="0,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Kontakt und Support" 
                                       FontSize="13" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource HerkoGreen}"
                                       Margin="0,0,0,10"/>
                            

                            <TextBlock Foreground="{StaticResource HerkoGreen}" FontWeight="Bold" Margin="0,3,0,0">
                                <Run Text="✉️ E-Mail: "/>
                                <Run Text="hoelzer_alex@yahoo.de"/>
                            </TextBlock>
                            
                            <TextBlock Foreground="{StaticResource HerkoGreen}" FontWeight="Bold" Margin="0,3,0,0">
                                <Run Text="📱 Telefon: "/>
                                <Run Text="+49 170 8339993"/>
                            </TextBlock>
                            
                            <TextBlock Foreground="#AAA" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap">
                                Nach Bestätigung erhalten Sie Ihren Lizenzschlüssel sowie die Freischaltung für die vereinbarte Laufzeit.
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button Content="Abbrechen" 
                        Click="OnCancel"
                        Background="#444" 
                        Foreground="White"
                        Padding="20,10"
                        Margin="0,0,10,0"
                        BorderThickness="0"
                        Cursor="Hand"
                        FontSize="13"
                        FontWeight="Bold">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#444"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="3"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#555"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                
                <Button x:Name="ActivateButton"
                        Content="✓ Lizenz aktivieren" 
                        Click="OnActivate"
                        Background="{StaticResource HerkoGreen}" 
                        Foreground="White"
                        Padding="20,10"
                        BorderThickness="0"
                        Cursor="Hand"
                        IsEnabled="False"
                        FontSize="13"
                        FontWeight="Bold">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="3"
                                                Padding="{TemplateBinding Padding}">
                                            <TextBlock Text="{TemplateBinding Content}" 
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"
                                                       Foreground="{TemplateBinding Foreground}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#666"/>
                                    <Setter Property="Foreground" Value="#CCC"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="True">
                                    <Setter Property="Background" Value="{StaticResource HerkoGreen}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource HerkoGreenDark}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
