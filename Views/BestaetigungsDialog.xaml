<Window x:Class="MaterialManager_V01.Views.BestaetigungsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bestätigung"
        Width="700"
        MinWidth="700"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ThemeWindowBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleTextBlock" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
            <Border Background="#252525" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="6" Padding="12">
                <TextBlock x:Name="MessageTextBlock" Foreground="#D0D0D0" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <WrapPanel x:Name="ButtonPanel" Grid.Row="1" HorizontalAlignment="Left" Margin="0,18,0,0" ItemHeight="42"/>
    </Grid>
</Window>