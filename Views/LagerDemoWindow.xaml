<Window x:Class="MaterialManager_V01.Views.LagerDemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MaterialManager_V01.Views.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Lager - Materialübersicht"
        Height="840"
        Width="1500"
        FontSize="13"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        BorderBrush="{DynamicResource ThemeBorderBrush}"
        BorderThickness="1"
        Icon="/Assets/app-icon.png"
        Background="{DynamicResource ThemeWindowBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="FilterComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"/>

                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>

                            <ToggleButton Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Opacity="0.01"/>

                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FilterComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B7C7BA"/>
                                <Setter Property="Foreground" Value="#102018"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#A5B8AA"/>
                                <Setter Property="Foreground" Value="#102018"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#222"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"/>

                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>

                            <ToggleButton Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Opacity="0.01"/>

                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0F5AA6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboBoxItemStyle}"/>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#121212"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="RowBackground" Value="#1A1A1A"/>
            <Setter Property="AlternatingRowBackground" Value="#151515"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="BorderBrush" Value="#333"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="#1B5E20"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AuftragNr}" Value="">
                    <Setter Property="Background" Value="Transparent"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AuftragNr}" Value="{x:Null}">
                    <Setter Property="Background" Value="Transparent"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IstReserviert}" Value="True">
                    <Setter Property="Background" Value="#1B5E20"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E4E79"/>
                </Trigger>
            </Style.Triggers>
        </Style>
<Style TargetType="Menu">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Icon"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0" ContentSource="Icon" Margin="4,0,6,0" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="20,0,6,0" VerticalAlignment="Center" Foreground="#888"/>
                                <Path Grid.Column="3" x:Name="ArrowPath" Margin="4,0,0,0" VerticalAlignment="Center" Fill="White" Data="M 0 0 L 4 4 L 0 8 Z" Visibility="Collapsed"/>

                                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Right" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" VerticalOffset="-3">
                                    <Border Background="{DynamicResource ThemeAltSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="2">
                                        <ScrollViewer CanContentScroll="True" MaxHeight="400">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="Border" Property="Background" Value="#1F1F1F"/>
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                            </Trigger>
                            <Trigger Property="Role" Value="TopLevelItem">
                                <Setter TargetName="Border" Property="Background" Value="#1F1F1F"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="ArrowPath" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="4,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource ThemeSurfaceBrush}" Height="32">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="/Assets/app-icon.png" Width="16" Height="16" Margin="8,0,10,0" VerticalAlignment="Center"/>

                    <Menu Grid.Column="1" VerticalAlignment="Center" FontSize="13">
                        <MenuItem Header="Datei">
                            <MenuItem Header="Material neu" Click="OnNewMaterialClick"/>
                            <MenuItem Header="Aktualisieren" Click="OnRefreshClick"/>
                            <MenuItem Header="Netzwerkordner öffnen" Click="OnOpenNetworkFolder"/>
                            <Separator/>
                            <MenuItem Header="Startseite" Click="OnOpenStartProgramClick"/>
                            <MenuItem Header="Hauptprogramm" Click="OnOpenMainProgramClick"/>
                            <MenuItem Header="Schließen" Click="OnCloseClick"/>
                        </MenuItem>
                        <MenuItem Header="Bearbeiten">
                            <MenuItem Header="Zurück" InputGestureText="Strg+Z" Click="OnUndoClick"/>
                            <MenuItem Header="Vorwärts" InputGestureText="Strg+Y" Click="OnRedoClick"/>
                            <Separator/>
                            <MenuItem Header="Material bearbeiten" Click="OnEditMaterialClick"/>
                            <MenuItem Header="Material löschen" Click="OnDeleteMaterialClick"/>
                        </MenuItem>
                        <MenuItem Header="Ansicht">
                            <MenuItem Header="Regalauslastung" Click="OnShelfUtilizationClick"/>
                            <MenuItem Header="Inventur" Click="OnInventoryClick"/>
                            <MenuItem Header="Niedrige Bestände" Click="OnLowStockClick"/>
                        </MenuItem>
                        <MenuItem Header="Hilfe">
                            <MenuItem Header="Programm- &amp; Netzwerkanleitung" Click="OnProgrammHilfe"/>
                            <MenuItem Header="Nach Updates suchen" Click="OnCheckForUpdates"/>
                        </MenuItem>
                    </Menu>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                        <Button Style="{StaticResource TitleBarButtonStyle}" Width="36" MinHeight="26" Margin="0,0,4,0" Content="↶" Click="OnUndoClick" ToolTip="Zurück"/>
                        <Button Style="{StaticResource TitleBarButtonStyle}" Width="36" MinHeight="26" Content="↷" Click="OnRedoClick" ToolTip="Vorwärts"/>
                    </StackPanel>

                    <TextBlock x:Name="LicenseBannerTextBlock"
                               Grid.ColumnSpan="4"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               FontSize="14"
                               IsHitTestVisible="False"
                               TextTrimming="CharacterEllipsis"/>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource TitleBarButtonStyle}" Content="—" Click="OnMinimizeWindow"/>
                        <Button Style="{StaticResource TitleBarButtonStyle}" Content="▢" Click="OnMaximizeRestoreWindow"/>
                        <Button Style="{StaticResource CloseTitleBarButtonStyle}" Content="✕" Click="OnCloseWindow"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Top" Background="{DynamicResource ThemeSurfaceBrush}" Padding="10" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="/Assets/app-icon.png" Width="16" Height="16" Margin="6,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Lager – Materialübersicht" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="{Binding HeaderText}" Foreground="#AAAAAA" Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Right">
                        <TextBlock x:Name="NetworkModeTextBlock"
                                   Foreground="#9E9E9E"
                                   FontSize="10"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,0,2"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="NetworkExcelTextBlock"
                                   Foreground="#9E9E9E"
                                   FontSize="9"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,0,2"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="AutoSyncStatusTextBlock"
                                   Foreground="#81C784"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   Height="16"
                                   Opacity="0"
                                   Margin="0,0,0,6"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <controls:ModuleNavigationButtons ShowHauptprogramm="False"
                                                                StartseiteClick="OnOpenStartProgramClick"/>
                            <Button Content="Laser"
                                    Click="OnOpenLaserProgramClick"
                                    Style="{StaticResource AppButton3DSuccessStyle}"
                                    Padding="14,8"
                                    Margin="0,0,8,0"/>
                            <Button Content="Auftragssteuerung"
                                    Click="OnOpenTafelplanungProgramClick"
                                    Style="{StaticResource AppButton3DTealStyle}"
                                    Padding="14,8"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Top" Background="{DynamicResource ThemeSurfaceBrush}" Padding="12">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Regalauslastung"
                                Click="OnShelfUtilizationClick"
                                Style="{StaticResource AppButton3DPrimaryStyle}"
                                Padding="12,8"
                                Margin="0,0,8,0"/>
                        <Button Content="Niedrige Bestände"
                                Click="OnLowStockClick"
                                Style="{StaticResource AppButton3DWarningStyle}"
                                Padding="12,8"
                                Margin="0,0,8,0"/>
                        <Button Content="Inventur"
                                Click="OnInventoryClick"
                                Style="{StaticResource AppButton3DTealStyle}"
                                Padding="12,8"
                                Margin="0,0,8,0"/>
                        <Button Content="Aktualisieren"
                                Click="OnRefreshClick"
                                Style="{StaticResource AppButton3DSecondaryStyle}"
                                Padding="12,8"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Material neu"
                                Click="OnNewMaterialClick"
                                Style="{StaticResource AppButton3DSuccessStyle}"
                                Padding="12,8"
                                Margin="0,0,8,0"/>
                        <Button Content="Material bearbeiten"
                                Click="OnEditMaterialClick"
                                Style="{StaticResource AppButton3DInfoStyle}"
                                Padding="12,8"
                                Margin="0,0,8,0"/>
                        <Button Content="Reservieren"
                                Click="OnReserveMaterialClick"
                                Style="{StaticResource AppButton3DPrimaryStyle}"
                                Padding="12,8"
                                Margin="0,0,8,0"/>
                        <Button Content="Reservierung aufheben"
                                Click="OnReleaseReservationClick"
                                Style="{StaticResource AppButton3DDangerStyle}"
                                Padding="12,8"
                                Margin="0,0,8,0"/>
                        <Button Content="Material löschen"
                                Click="OnDeleteMaterialClick"
                                Style="{StaticResource AppButton3DDangerStyle}"
                                Padding="12,8"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Top" Background="#0E0E0E" Padding="12">
                <StackPanel>
                    <TextBlock Text="Spaltenfilter (manuell):" Foreground="{DynamicResource ThemeForegroundBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <WrapPanel>
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Text="Material" Foreground="{DynamicResource ThemeMutedForegroundBrush}" FontSize="11"/>
                                <ComboBox x:Name="FilterMaterialBox" Width="140" Height="30" Padding="8,4"
                                          Style="{StaticResource FilterComboBoxStyle}"
                                          ItemContainerStyle="{StaticResource FilterComboBoxItemStyle}"
                                          SelectionChanged="OnColumnFilterSelectionChanged"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Text="Stärke" Foreground="{DynamicResource ThemeMutedForegroundBrush}" FontSize="11"/>
                                <ComboBox x:Name="FilterStaerkeBox" Width="100" Height="30" Padding="8,4"
                                          Style="{StaticResource FilterComboBoxStyle}"
                                          ItemContainerStyle="{StaticResource FilterComboBoxItemStyle}"
                                          SelectionChanged="OnColumnFilterSelectionChanged"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,6"><TextBlock Text="Maß" Foreground="{DynamicResource ThemeMutedForegroundBrush}" FontSize="11"/><TextBox x:Name="FilterMassBox" Width="120" Height="30" Padding="8,4" Background="{DynamicResource ThemeSurfaceBrush}" Foreground="{DynamicResource ThemeForegroundBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" TextChanged="OnColumnFilterChanged"/></StackPanel>
                            <StackPanel Margin="0,0,10,6"><TextBlock Text="Länge (mm)" Foreground="{DynamicResource ThemeMutedForegroundBrush}" FontSize="11"/><TextBox x:Name="FilterLaengeBox" Width="90" Height="30" Padding="8,4" Background="{DynamicResource ThemeSurfaceBrush}" Foreground="{DynamicResource ThemeForegroundBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" TextChanged="OnColumnFilterChanged"/></StackPanel>
                            <StackPanel Margin="0,0,10,6"><TextBlock Text="Lagerort" Foreground="{DynamicResource ThemeMutedForegroundBrush}" FontSize="11"/><TextBox x:Name="FilterLagerortBox" Width="110" Height="30" Padding="8,4" Background="{DynamicResource ThemeSurfaceBrush}" Foreground="{DynamicResource ThemeForegroundBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" TextChanged="OnColumnFilterChanged"/></StackPanel>
                            <StackPanel Margin="0,0,10,6"><TextBlock Text="Restnummer" Foreground="{DynamicResource ThemeMutedForegroundBrush}" FontSize="11"/><TextBox x:Name="FilterRestnummerBox" Width="120" Height="30" Padding="8,4" Background="{DynamicResource ThemeSurfaceBrush}" Foreground="{DynamicResource ThemeForegroundBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" TextChanged="OnColumnFilterChanged"/></StackPanel>
                            <StackPanel Margin="0,0,10,6"><TextBlock Text="Auftrag" Foreground="{DynamicResource ThemeMutedForegroundBrush}" FontSize="11"/><TextBox x:Name="FilterAuftragBox" Width="120" Height="30" Padding="8,4" Background="{DynamicResource ThemeSurfaceBrush}" Foreground="{DynamicResource ThemeForegroundBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" TextChanged="OnColumnFilterChanged"/></StackPanel>
                        </WrapPanel>
                    </ScrollViewer>
                    <TextBlock Text="{Binding SummaryText}" Foreground="{DynamicResource ThemeMutedForegroundBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <DataGrid x:Name="MaterialGrid"
                  ItemsSource="{Binding GefilterteMaterialien}"
                  AutoGenerateColumns="False"
                  Margin="10"
                  RowHeight="32"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  MouseDoubleClick="OnGridMouseDoubleClick"
                  PreviewMouseLeftButtonDown="OnGridPreviewMouseLeftButtonDown">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="35">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Material" Binding="{Binding MaterialArt}" Width="90"/>
                <DataGridTextColumn Header="Legierung" Binding="{Binding Legierung}" Width="100"/>
                <DataGridTextColumn Header="Oberfläche" Binding="{Binding Oberflaeche}" Width="120"/>
                <DataGridTextColumn Header="Kategorie" Binding="{Binding Kategorie}" Width="80"/>
                <DataGridTextColumn Header="Form" Binding="{Binding Form}" Width="60"/>
                <DataGridTextColumn Header="Stärke" Binding="{Binding Staerke, StringFormat={}{0:0.0} mm}" Width="80"/>
                <DataGridTextColumn Header="Maß" Binding="{Binding Mass}" Width="120"/>
                <DataGridTextColumn Header="Länge (mm)" Binding="{Binding LaengeAnzeige}" Width="90"/>
                <DataGridTextColumn Header="Stück" Binding="{Binding Stueckzahl}" Width="60"/>
                <DataGridTextColumn Header="Gewicht (kg)" Binding="{Binding GewichtKg, StringFormat={}{0:0.00}}" Width="95"/>
                <DataGridTextColumn Header="Lagerort" Binding="{Binding Lagerort}" Width="90"/>
                <DataGridTextColumn Header="Angelegt von" Binding="{Binding AngelegtVon}" Width="120"/>
                <DataGridTextColumn Header="Geändert von" Binding="{Binding GeaendertVon}" Width="120"/>
                <DataGridTextColumn Header="Angelegt am" Binding="{Binding Datum, StringFormat=dd.MM.yyyy HH:mm}" Width="145"/>
                <DataGridTextColumn Header="Geändert am" Binding="{Binding AenderungsDatum, StringFormat=dd.MM.yyyy HH:mm}" Width="145"/>
                <DataGridTextColumn Header="Restnummer" Binding="{Binding Restnummer}" Width="110"/>
                <DataGridTextColumn Header="Auftrag" Binding="{Binding AuftragNr}" Width="140"/>
                <DataGridTextColumn Header="PDF" Binding="{Binding PdfDateiname}" Width="170" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#FF9800"/>
                            <Setter Property="ToolTip" Value="{Binding PdfPfad}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
    </Grid>
</Window>