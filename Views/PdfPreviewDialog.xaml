<Window x:Class="MaterialManager_V01.Views.PdfPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF-Vorschau"
        Height="430"
        Width="700"
        Background="#0B0B0B"
        Foreground="White"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        FontSize="13">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinWidth" Value="120"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2E2E2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseTitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#2A2A2A" BorderThickness="1" Background="#0B0B0B">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#1F1F1F" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="PDF-Vorschau" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold"/>
                    <Button Grid.Column="1" Style="{StaticResource CloseTitleBarButtonStyle}" Content="✕" Click="OnCloseClick"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="PDF-Vorschau" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

                <Border Grid.Row="1" Background="#1E1E1E" Padding="12" CornerRadius="4" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Dateiname:" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1" x:Name="FileNameTextBlock" FontWeight="Bold" Foreground="#8EC5FF" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="#1A1A1A" Padding="12" CornerRadius="4" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Dateipfad:" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1" x:Name="FilePathTextBlock" Foreground="#666" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Dateigröße:" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="FileSizeTextBlock" Margin="8,0,0,0"/>

                    <TextBlock Grid.Column="2" Text="Änderungsdatum:" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="24,0,0,0"/>
                    <TextBlock Grid.Column="3" x:Name="ModifiedDateTextBlock" Margin="8,0,0,0"/>
                </Grid>

                <Border Grid.Row="4" Background="#1B5E20" Padding="12" CornerRadius="4" Margin="0,0,0,16">
                    <TextBlock x:Name="StatusTextBlock" Text="PDF ist bereit zum Öffnen" Foreground="White"/>
                </Border>

                <Border Grid.Row="6" Background="#1A1A1A" Padding="12" CornerRadius="4" Margin="0,0,0,12">
                    <TextBlock x:Name="InfoTextBlock" Text="Diese PDF wird in der Standard-Anwendung Ihres Systems geöffnet." Foreground="#AAAAAA" TextWrapping="Wrap"/>
                </Border>

                <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="📄 Extern öffnen" Click="OnOpenExternalClick" Background="#1976D2" Margin="0,0,8,0"/>
                    <Button Content="Kopieren (Pfad)" Click="OnCopyPathClick" Background="#455A64" Margin="0,0,8,0"/>
                    <Button Content="Schließen" Click="OnCloseClick" Background="#555"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
