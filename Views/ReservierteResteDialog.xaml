<Window x:Class="MaterialManager_V01.Views.ReservierteResteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔖 Reservierte Reste"
        Height="600"
        Width="1200"
        Background="{DynamicResource ThemeWindowBackgroundBrush}"
        Foreground="{DynamicResource ThemeForegroundBrush}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#121212"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="RowBackground" Value="#1A1A1A"/>
            <Setter Property="AlternatingRowBackground" Value="#151515"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="BorderBrush" Value="#333"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="#1B5E20"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AuftragNr}" Value="">
                    <Setter Property="Background" Value="Transparent"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AuftragNr}" Value="{x:Null}">
                    <Setter Property="Background" Value="Transparent"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IstReserviert}" Value="True">
                    <Setter Property="Background" Value="#1B5E20"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Background="{DynamicResource ThemeWindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource ThemeSurfaceBrush}" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔖 Reservierte Reste" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold"/>
                    <Button Grid.Column="1" Style="{StaticResource TitleBarButtonStyle}" Content="✕" Click="OnCloseWindowClick"/>
                </Grid>
            </Border>

            <DockPanel Grid.Row="1">
                <Border DockPanel.Dock="Top" Background="{DynamicResource ThemeSurfaceBrush}" Padding="15">
                    <StackPanel>
                        <TextBlock Text="🔖 Reservierte Reste" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ThemeForegroundBrush}"/>
                        <TextBlock Text="Materialien die für Aufträge reserviert sind" Foreground="#888" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Background="{DynamicResource ThemeSurfaceBrush}" Padding="10">
                    <Button Content="Schließen" Click="OnSchliessen" Width="100" Style="{StaticResource AppButton3DPrimaryStyle}" Padding="8"/>
                </Border>

                <DataGrid x:Name="ReservierteResteGrid"
                          ItemsSource="{Binding ReservierteReste}"
                          AutoGenerateColumns="False"
                          Margin="10"
                          IsReadOnly="True"
                          Background="#121212"
                          Foreground="{DynamicResource ThemeForegroundBrush}"
                          MouseDoubleClick="OnGridMouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Material" Binding="{Binding MaterialArt}" Width="100"/>
                        <DataGridTextColumn Header="Legierung" Binding="{Binding Legierung}" Width="100"/>
                        <DataGridTextColumn Header="Form" Binding="{Binding Form}" Width="70"/>
                        <DataGridTextColumn Header="Stärke" Binding="{Binding Staerke, StringFormat={}{0:0.0} mm}" Width="80"/>
                        <DataGridTextColumn Header="Maß" Binding="{Binding Mass}" Width="120"/>
                        <DataGridTextColumn Header="Stück" Binding="{Binding Stueckzahl}" Width="60"/>
                        <DataGridTextColumn Header="Gewicht (kg)" Binding="{Binding GewichtKg}" Width="100"/>
                        <DataGridTextColumn Header="Restnummer" Binding="{Binding Restnummer}" Width="120"/>
                        <DataGridTextColumn Header="🎯 Auftrag" Binding="{Binding AuftragNr}" Width="200"/>
                        <DataGridTemplateColumn Header="PDF" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding PdfDateiname}"
                                            Click="OnPdfButtonClick"
                                            ToolTip="{Binding PdfPfad}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="#FF9800"
                                            HorizontalContentAlignment="Left"
                                            Padding="0"
                                            Cursor="Hand"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Reserviert von" Binding="{Binding GeaendertVon}" Width="120"/>
                        <DataGridTextColumn Header="Geändert" Binding="{Binding AenderungsDatum, StringFormat=dd.MM.yyyy}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </Border>
</Window>
