<Window x:Class="MaterialManager_V01.Views.ProduktionsBegruendungDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Begründung erfassen"
        Height="360"
        Width="680"
        MinWidth="620"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeWindowBackgroundBrush}"
        Foreground="{DynamicResource ThemeForegroundBrush}"
        FontSize="13">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Produktionsbegründung" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Falls die Produktion länger gedauert hat, bitte Grund dokumentieren." Margin="0,8,0,0" Foreground="#B0BEC5"/>
        </StackPanel>

        <TextBox x:Name="KommentarTextBox"
                 Grid.Row="1"
                 Margin="0,12,0,12"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Background="{DynamicResource ThemeAltSurfaceBrush}"
                 Foreground="{DynamicResource ThemeForegroundBrush}"
                 BorderBrush="{DynamicResource ThemeBorderBrush}"
                 BorderThickness="1"
                 Padding="10"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Abbrechen" Width="120" MinHeight="38" Margin="0,0,8,0" Click="OnCancelClick" Style="{StaticResource AppButton3DSecondaryStyle}"/>
            <Button Content="Ohne Begründung" Width="150" MinHeight="38" Margin="0,0,8,0" Click="OnSkipClick" Style="{StaticResource AppButton3DInfoStyle}"/>
            <Button Content="Speichern" Width="120" MinHeight="38" Click="OnSaveClick" Style="{StaticResource AppButton3DSuccessStyle}"/>
        </StackPanel>
    </Grid>
</Window>