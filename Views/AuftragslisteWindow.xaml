<Window x:Class="MaterialManager_V01.Views.AuftragslisteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auftragsliste"
        Height="720"
        Width="1200"
        WindowStartupLocation="CenterOwner"
        Background="#0B0B0B"
        FontSize="13">
    <Window.Resources>
        <Style x:Key="ArbeitsbereichTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B0BEC5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Arbeitsplatz}" Value="Laser">
                    <Setter Property="Foreground" Value="#66BB6A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Arbeitsplatz}" Value="Kantbank">
                    <Setter Property="Foreground" Value="#FFB74D"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Arbeitsplatz}" Value="Beides">
                    <Setter Property="Foreground" Value="#90CAF9"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#121212"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="RowBackground" Value="#1A1A1A"/>
            <Setter Property="AlternatingRowBackground" Value="#151515"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="BorderBrush" Value="#333"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E4E79"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Auftragsliste"
                   Foreground="White"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Text="Doppelklick oder 'Auftrag anzeigen' übernimmt den Auftrag direkt in die Auftragssteuerung."
                   Foreground="#AAAAAA"
                   Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Margin="12,0,0,10">
            <TextBlock Text="Suchen:"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <TextBox x:Name="SearchBox"
                     Width="220"
                     Background="#222"
                     Foreground="White"
                     BorderBrush="#444"
                     Padding="8,5"
                     TextChanged="OnSearchTextChanged"/>
        </StackPanel>

        <DataGrid x:Name="AuftragsGrid"
                  Grid.Row="2"
                  Grid.ColumnSpan="2"
                  ItemsSource="{Binding Auftraege}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  MouseDoubleClick="OnGridMouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Auftrag" Binding="{Binding Auftragsnummer}" Width="180"/>
                <DataGridTextColumn Header="Bereich" Binding="{Binding Arbeitsplatz}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource ArbeitsbereichTextStyle}"/>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140"/>
                <DataGridTextColumn Header="Positionen" Binding="{Binding MaterialPositionen}" Width="90"/>
                <DataGridTextColumn Header="Stückzahl" Binding="{Binding GesamtStueckzahl}" Width="90"/>
                <DataGridTextColumn Header="Gewicht (kg)" Binding="{Binding GesamtGewichtKg, StringFormat={}{0:0.00}}" Width="100"/>
                <DataGridTextColumn Header="Angelegt von" Binding="{Binding AngelegtVon}" Width="120"/>
                <DataGridTextColumn Header="Geändert von" Binding="{Binding GeaendertVon}" Width="120"/>
                <DataGridTextColumn Header="Erstellt" Binding="{Binding ErstelltAm, StringFormat=dd.MM.yyyy HH:mm}" Width="140"/>
                <DataGridTextColumn Header="Geändert" Binding="{Binding GeaendertAm, StringFormat=dd.MM.yyyy HH:mm}" Width="140"/>
                <DataGridTextColumn Header="Produktion" Binding="{Binding ProduktionsDauer}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Aktualisieren"
                    Click="OnRefreshClick"
                    Background="#555"
                    Foreground="White"
                    Padding="12,8"
                    Margin="0,0,8,0"/>
            <Button Content="Auftrag anzeigen"
                    Click="OnUseSelectedClick"
                    Background="#1976D2"
                    Foreground="White"
                    Padding="12,8"
                    Margin="0,0,8,0"/>
            <Button Content="Schließen"
                    Click="OnCloseClick"
                    Background="#444"
                    Foreground="White"
                    Padding="12,8"/>
        </StackPanel>
    </Grid>
</Window>