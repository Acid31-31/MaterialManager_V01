<Window x:Class="MaterialManager_V01.Views.AuftragslisteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auftragsliste"
        Height="820"
        Width="1680"
        MinWidth="1400"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        Background="#0B0B0B"
        FontSize="13">
    <Window.Resources>
        <Style x:Key="ArbeitsbereichTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B0BEC5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Arbeitsplatz}" Value="Laser">
                    <Setter Property="Foreground" Value="#66BB6A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Arbeitsplatz}" Value="Kantbank">
                    <Setter Property="Foreground" Value="#FFB74D"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Arbeitsplatz}" Value="Beides">
                    <Setter Property="Foreground" Value="#90CAF9"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <ToggleButton Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent"
                                          BorderBrush="Transparent"
                                          BorderThickness="0"/>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#1A1A1A" BorderBrush="#444" BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1976D2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#121212"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="RowBackground" Value="#1A1A1A"/>
            <Setter Property="AlternatingRowBackground" Value="#151515"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="BorderBrush" Value="#333"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E4E79"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Auftragsliste"
                   Foreground="White"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Text="Doppelklick öffnet die PDF des Auftrags. 'Auftrag anzeigen' übernimmt den Auftrag in die Auftragssteuerung."
                   Foreground="#AAAAAA"
                   Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Margin="12,0,0,10">
            <TextBlock Text="Quelle:"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <ComboBox x:Name="SourceFilterBox"
                      Width="130"
                      Background="#222"
                      Foreground="White"
                      BorderBrush="#444"
                      Padding="8,4"
                      Margin="0,0,10,0"
                      SelectionChanged="OnSourceFilterChanged">
                 <ComboBoxItem>Alle</ComboBoxItem>
                 <ComboBoxItem>Aktiv</ComboBoxItem>
                 <ComboBoxItem IsSelected="True">Archiviert</ComboBoxItem>
             </ComboBox>
            <TextBlock Text="Jahr:"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <ComboBox x:Name="YearFilterBox"
                      Width="95"
                      Background="#222"
                      Foreground="White"
                      BorderBrush="#444"
                      Padding="8,4"
                      Margin="0,0,10,0"
                      SelectionChanged="OnYearFilterChanged"/>
            <TextBlock Text="KW:"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <ComboBox x:Name="KwFilterBox"
                      Width="110"
                      Background="#222"
                      Foreground="White"
                      BorderBrush="#444"
                      Padding="8,4"
                      Margin="0,0,12,0"
                      SelectionChanged="OnKwFilterChanged"/>
            <TextBlock Text="Suchen:"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <TextBox x:Name="SearchBox"
                     Width="220"
                     Background="#222"
                     Foreground="White"
                     BorderBrush="#444"
                     Padding="8,5"
                     TextChanged="OnSearchTextChanged"/>
        </StackPanel>

        <DataGrid x:Name="AuftragsGrid"
                  Grid.Row="2"
                  Grid.ColumnSpan="2"
                  ItemsSource="{Binding Auftraege}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HorizontalScrollBarVisibility="Auto"
                  MouseDoubleClick="OnGridMouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Auftrag" Binding="{Binding Auftragsnummer}" Width="240"/>
                <DataGridTextColumn Header="Bereich" Binding="{Binding Arbeitsplatz}" Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource ArbeitsbereichTextStyle}"/>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140"/>
                <DataGridTextColumn Header="Material" Binding="{Binding MaterialAnzeige}" Width="220"/>
                <DataGridTextColumn Header="Stückzahl" Binding="{Binding GesamtStueckzahl}" Width="95"/>
                <DataGridTextColumn Header="Gewicht (kg)" Binding="{Binding GesamtGewichtKg, StringFormat={}{0:0.00}}" Width="110"/>
                <DataGridTextColumn Header="Angelegt von" Binding="{Binding AngelegtVon}" Width="170"/>
                <DataGridTextColumn Header="Geändert von" Binding="{Binding GeaendertVon}" Width="170"/>
                <DataGridTextColumn Header="Erstellt" Binding="{Binding ErstelltAm, StringFormat=dd.MM.yyyy HH:mm}" Width="150"/>
                <DataGridTextColumn Header="Geändert" Binding="{Binding GeaendertAm, StringFormat=dd.MM.yyyy HH:mm}" Width="150"/>
                <DataGridTextColumn Header="Produktion" Binding="{Binding ProduktionsDauer}" Width="110"/>
                <DataGridTextColumn Header="Kommentar" Binding="{Binding ProduktionsBegruendung}" Width="260"/>
                <DataGridTemplateColumn Header="PDF" Width="260">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding PdfDateiname}"
                                    Click="OnOpenPdfClick"
                                    ToolTip="{Binding PdfPfad}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#4CAF50"
                                    HorizontalContentAlignment="Left"
                                    Padding="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Aktualisieren"
                    Click="OnRefreshClick"
                    Background="#555"
                    Foreground="White"
                    Padding="12,8"
                    Margin="0,0,8,0"/>
            <Button Content="Auftrag anzeigen"
                    Click="OnUseSelectedClick"
                    Background="#1976D2"
                    Foreground="White"
                    Padding="12,8"
                    Margin="0,0,8,0"/>
            <Button Content="Schließen"
                    Click="OnCloseClick"
                    Background="#444"
                    Foreground="White"
                    Padding="12,8"/>
        </StackPanel>
    </Grid>
</Window>