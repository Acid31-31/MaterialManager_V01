<Window x:Class="MaterialManager_V01.Views.ProduktionVerfolgungDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Produktionsverfolgung"
        Height="620"
        Width="760"
        MinHeight="560"
        MinWidth="700"
        Background="#0B0B0B"
        Foreground="White"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FontSize="13">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource AppButton3DBaseStyle}">
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Height" Value="45"/>
        </Style>
        <Style x:Key="GreenButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButton3DSuccessStyle}">
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Height" Value="45"/>
        </Style>
        <Style x:Key="RedButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButton3DDangerStyle}">
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Height" Value="45"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Produktionsverfolgung" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,20">
            <Button Content="Laser"
                    Click="OnOpenLaserProgramClick"
                    Style="{StaticResource AppButton3DSuccessStyle}"
                    Padding="14,8"
                    Margin="0,0,8,0"/>
            <Button Content="Lager"
                    Click="OnOpenLagerProgramClick"
                    Style="{StaticResource AppButton3DTealStyle}"
                    Padding="14,8"
                    Margin="0,0,8,0"/>
            <Button Content="Schließen"
                    Click="OnCloseWindow"
                    Style="{StaticResource AppButton3DDangerStyle}"
                    Padding="14,8"/>
        </StackPanel>

        <Border Grid.Row="2" Background="#1E1E1E" Padding="16" CornerRadius="4" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Auftrag:" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Grid.Column="1" x:Name="AuftragTextBlock" FontSize="18" FontWeight="Bold" Foreground="#8EC5FF" VerticalAlignment="Center"/>
                <Button Grid.Column="2"
                        x:Name="KwAuswahlButton"
                        Content="KW --"
                        Width="150"
                        Height="36"
                        Padding="12,6"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Style="{StaticResource AppButton3DInfoStyle}"
                        Margin="12,0,0,0"
                        Click="OnKwAuswahlClick"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Text="Produktionsbeginn:" Foreground="#AAAAAA" Margin="0,0,0,8"/>
        <Border Grid.Row="4" Background="#1A1A1A" Padding="12" CornerRadius="4" Margin="0,0,0,16">
            <TextBlock x:Name="StartZeitTextBlock" FontSize="16" Text="Nicht gestartet" Foreground="White"/>
        </Border>

        <TextBlock Grid.Row="5" Text="Produktionsende:" Foreground="#AAAAAA" Margin="0,0,0,8"/>
        <Border Grid.Row="6" Background="#1A1A1A" Padding="12" CornerRadius="4" Margin="0,0,0,16">
            <TextBlock x:Name="EndZeitTextBlock" FontSize="16" Text="Nicht beendet" Foreground="White"/>
        </Border>

        <Border Grid.Row="7" Background="#1B5E20" Padding="12" CornerRadius="4" Margin="0,0,0,20">
            <TextBlock x:Name="DauerTextBlock" FontSize="14" Text="Dauer: –" Foreground="White"/>
        </Border>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="▶ Start" Style="{StaticResource GreenButtonStyle}" Click="OnStartClick" x:Name="StartButton"/>
            <Button Content="⏹ Ende" Style="{StaticResource RedButtonStyle}" Click="OnEndClick" x:Name="EndButton" IsEnabled="False" Margin="12,0,0,0"/>
            <Button Content="Schließen" Style="{StaticResource AppButton3DSecondaryStyle}" Click="OnCloseClick" Margin="24,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button Content="PDF nachtragen" Style="{StaticResource AppButton3DPrimaryStyle}" Click="OnAttachOrderPdfClick" MinWidth="170" Height="40" Padding="14,8"/>
            <Button Content="Auftrag löschen" Style="{StaticResource AppButton3DDangerStyle}" Click="OnDeleteOrderClick" MinWidth="170" Height="40" Padding="14,8" Margin="12,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
