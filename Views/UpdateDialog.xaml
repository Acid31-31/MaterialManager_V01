<Window x:Class="MaterialManager_V01.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔄 Updates verfügbar"
        Height="560"
        Width="760"
        Background="{DynamicResource ThemeWindowBackgroundBrush}"
        Foreground="{DynamicResource ThemeForegroundBrush}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Background="{DynamicResource ThemeWindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource ThemeSurfaceBrush}" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔄 Updates verfügbar" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold"/>
                    <Button Grid.Column="1" Style="{StaticResource TitleBarButtonStyle}" Content="✕" Click="OnCloseWindowClick"/>
                </Grid>
            </Border>

            <DockPanel Grid.Row="1">
                <Border DockPanel.Dock="Top" Background="{DynamicResource ThemeSurfaceBrush}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="🔄 MaterialManager Update" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ThemeForegroundBrush}"/>
                        <TextBlock Text="Eine neue Version ist verfügbar!" Foreground="#4CAF50" FontSize="14" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Background="{DynamicResource ThemeSurfaceBrush}" Padding="15">
                    <StackPanel>
                        <ProgressBar Height="14" Minimum="0" Maximum="100" Value="{Binding DownloadProgress}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding DownloadStatus}" Foreground="#AAA" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="MSI herunterladen &amp; installieren" Click="OnInstallieren" Style="{StaticResource AppButton3DSuccessStyle}" Padding="15,8" Margin="0,0,10,0" FontWeight="Bold"/>
                            <Button Content="Release im Browser" Click="OnOpenRelease" Style="{StaticResource AppButton3DPrimaryStyle}" Padding="15,8" Margin="0,0,10,0"/>
                            <Button Content="Später" Click="OnSpaeter" Style="{StaticResource AppButton3DSecondaryStyle}" Padding="15,8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer Margin="20" Background="#121212">
                    <StackPanel>
                        <Border Background="{DynamicResource ThemeAltSurfaceBrush}" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Version" Foreground="#888" FontSize="12"/>
                                <TextBlock Text="{Binding VersionInfo}" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="18" FontWeight="Bold" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource ThemeAltSurfaceBrush}" CornerRadius="6" Padding="15">
                            <StackPanel>
                                <TextBlock Text="📝 Was wurde geändert:" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                                <TextBox Text="{Binding Changelog}"
                                         Foreground="{DynamicResource ThemeForegroundBrush}"
                                         Background="{DynamicResource ThemeAltSurfaceBrush}"
                                         BorderThickness="0"
                                         TextWrapping="Wrap"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         MinHeight="170"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</Window>
