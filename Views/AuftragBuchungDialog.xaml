<Window x:Class="MaterialManager_V01.Views.AuftragBuchungDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Für Auftrag buchen"
        Height="230"
        Width="420"
        Background="#1E1E1E"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Material für Auftrag buchen" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

        <TextBlock Grid.Row="1" Text="Auftragsnummer" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox x:Name="AuftragTextBox" Grid.Row="1" Grid.Column="1" Background="#222" Foreground="White" BorderBrush="#444" Padding="8,6" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="2" Text="Menge" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox x:Name="MengeTextBox" Grid.Row="2" Grid.Column="1" Background="#222" Foreground="White" BorderBrush="#444" Padding="8,6" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" x:Name="InfoTextBlock" Foreground="#AAAAAA" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Abbrechen" Click="OnCancel" Background="#555" Foreground="White" Padding="12,8" Margin="0,0,8,0"/>
            <Button Content="OK" Click="OnOk" Background="#1976D2" Foreground="White" Padding="18,8"/>
        </StackPanel>
    </Grid>
</Window>