<Window x:Class="MaterialManager_V01.Views.TafelplanungWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MaterialManager_V01.Views.Controls"
        Title="Auftragssteuerung - Materialbelegung"
        Height="820"
        Width="1500"
        FontSize="13"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        ResizeMode="CanResize"
        WindowStyle="None"
        BorderBrush="{DynamicResource ThemeBorderBrush}"
        BorderThickness="1"
        Icon="/Assets/app-icon.png"
        Background="{DynamicResource ThemeWindowBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="ArbeitsbereichTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B0BEC5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Arbeitsplatz}" Value="Laser">
                    <Setter Property="Foreground" Value="#66BB6A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Arbeitsplatz}" Value="Kantbank">
                    <Setter Property="Foreground" Value="#FFB74D"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Arbeitsplatz}" Value="Beides">
                    <Setter Property="Foreground" Value="#90CAF9"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#222"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"/>

                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>

                            <ToggleButton Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Opacity="0.01"/>

                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0F5AA6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#121212"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="RowBackground" Value="#1A1A1A"/>
            <Setter Property="AlternatingRowBackground" Value="#151515"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="BorderBrush" Value="#333"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="#1B5E20"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AuftragNr}" Value="">
                    <Setter Property="Background" Value="Transparent"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AuftragNr}" Value="{x:Null}">
                    <Setter Property="Background" Value="Transparent"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IstReserviert}" Value="True">
                    <Setter Property="Background" Value="#1B5E20"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E4E79"/>
                </Trigger>
            </Style.Triggers>
        </Style>
<Style TargetType="Menu">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Icon"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0" ContentSource="Icon" Margin="4,0,6,0" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="20,0,6,0" VerticalAlignment="Center" Foreground="#888"/>
                                <Path Grid.Column="3" x:Name="ArrowPath" Margin="4,0,0,0" VerticalAlignment="Center" Fill="White" Data="M 0 0 L 4 4 L 0 8 Z" Visibility="Collapsed"/>

                                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Right" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" VerticalOffset="-3">
                                    <Border Background="{DynamicResource ThemeAltSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="2">
                                        <ScrollViewer CanContentScroll="True" MaxHeight="400">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="Border" Property="Background" Value="#1F1F1F"/>
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                            </Trigger>
                            <Trigger Property="Role" Value="TopLevelItem">
                                <Setter TargetName="Border" Property="Background" Value="#1F1F1F"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="ArrowPath" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="4,2"/>
        </Style>
        <Style x:Key="DarkContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkContextMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1976D2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource ThemeSurfaceBrush}" Height="32">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="/Assets/app-icon.png" Width="16" Height="16" Margin="8,0,10,0" VerticalAlignment="Center"/>

                    <Menu Grid.Column="1" VerticalAlignment="Center" FontSize="13">
                        <MenuItem Header="Datei">
                            <MenuItem Header="Aktualisieren" Click="OnRefreshClick"/>
                            <MenuItem Header="Netzwerkordner öffnen" Click="OnOpenNetworkFolder"/>
                            <Separator/>
                            <MenuItem Header="Startseite" Click="OnOpenStartProgramClick"/>
                            <MenuItem Header="Hauptprogramm" Click="OnOpenMainProgramClick"/>
                            <MenuItem Header="Schließen" Click="OnCloseClick"/>
                        </MenuItem>
                        <MenuItem Header="Bearbeiten">
                            <MenuItem Header="Zurück" InputGestureText="Strg+Z" Click="OnUndoClick"/>
                            <MenuItem Header="Vorwärts" InputGestureText="Strg+Y" Click="OnRedoClick"/>
                            <Separator/>
                            <MenuItem Header="Für Auftrag buchen" Click="OnBookForOrderClick"/>
                            <MenuItem Header="Material löschen" Click="OnDeleteMaterialClick"/>
                            <MenuItem Header="Reservierung aufheben" Click="OnReleaseReservationClick"/>
                            <MenuItem Header="Produktion abschließen" Click="OnCompleteProductionClick"/>
                            <MenuItem Header="PDF anhängen" Click="OnAttachPdfClick"/>
                        </MenuItem>
                        <MenuItem Header="Ansicht">
                            <MenuItem Header="Auftragsliste" Click="OnOrderListClick"/>
                            <MenuItem Header="Gebuchte Materialien" Click="OnReservedRestsClick"/>
                            <MenuItem Header="Material suchen" Click="OnSearchRestsClick"/>
                            <MenuItem Header="Niedrige Bestände" Click="OnLowStockClick"/>
                        </MenuItem>
                        <MenuItem Header="Hilfe">
                            <MenuItem Header="Programm- &amp; Netzwerkanleitung" Click="OnProgrammHilfe"/>
                            <MenuItem Header="Nach Updates suchen" Click="OnCheckForUpdates"/>
                        </MenuItem>
                    </Menu>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                        <Button Style="{StaticResource TitleBarButtonStyle}" Width="36" MinHeight="26" Margin="0,0,4,0" Content="↶" Click="OnUndoClick" ToolTip="Zurück"/>
                        <Button Style="{StaticResource TitleBarButtonStyle}" Width="36" MinHeight="26" Content="↷" Click="OnRedoClick" ToolTip="Vorwärts"/>
                    </StackPanel>

                    <TextBlock x:Name="LicenseBannerTextBlock"
                               Grid.ColumnSpan="4"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               FontSize="14"
                               IsHitTestVisible="False"
                               TextTrimming="CharacterEllipsis"/>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource CloseTitleBarButtonStyle}" Content="✕" Click="OnCloseWindow"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Top" Background="{DynamicResource ThemeSurfaceBrush}" Padding="10" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="/Assets/app-icon.png" Width="16" Height="16" Margin="6,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Auftragssteuerung – Materialbelegung" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="{Binding HeaderText}" Foreground="#AAAAAA" Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Right">
                        <TextBlock x:Name="NetworkModeTextBlock"
                                   Foreground="#9E9E9E"
                                   FontSize="10"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,0,2"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="NetworkExcelTextBlock"
                                   Foreground="#9E9E9E"
                                   FontSize="9"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,0,2"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="AutoSyncStatusTextBlock"
                                   Foreground="#81C784"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   Height="16"
                                   Opacity="0"
                                   Margin="0,0,0,6"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <controls:ModuleNavigationButtons ShowHauptprogramm="False"
                                                                StartseiteClick="OnOpenStartProgramClick"/>
                            <Button Content="Laser"
                                    Click="OnOpenLaserProgramClick"
                                    Style="{StaticResource AppButton3DSuccessStyle}"
                                    Padding="14,8"
                                    Margin="0,0,8,0"/>
                            <Button Content="Lager"
                                    Click="OnOpenLagerProgramClick"
                                    Style="{StaticResource AppButton3DTealStyle}"
                                    Padding="14,8"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Left" Background="{DynamicResource ThemeSurfaceBrush}" Padding="10" Width="255">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Width="235">
                    <Button Style="{StaticResource AppButton3DCompactInfoStyle}" Content="Auftragsliste" Click="OnOrderListClick" Width="220" HorizontalContentAlignment="Left" Margin="0,0,0,10"/>

                    <TextBlock Text="Auftragsaktionen" Foreground="#FFB74D" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>
                    <Button Style="{StaticResource AppButton3DCompactInfoStyle}" Content="Auftrag nach oben" Click="OnMoveAuftragUpClick" Width="220" HorizontalContentAlignment="Left" Margin="0,0,0,5"/>
                    <Button Style="{StaticResource AppButton3DCompactInfoStyle}" Content="Auftrag nach unten" Click="OnMoveAuftragDownClick" Width="220" HorizontalContentAlignment="Left" Margin="0,0,0,5"/>
                    <Button Style="{StaticResource AppButton3DCompactDangerStyle}" Content="Als EILT markieren" Click="OnMarkEiltClick" Width="220" HorizontalContentAlignment="Left" Margin="0,0,0,5"/>
                    <Button Style="{StaticResource AppButton3DCompactTealStyle}" Content="Für Auftrag buchen" Click="OnBookForOrderClick" Width="220" HorizontalContentAlignment="Left" Margin="0,0,0,5"/>
                    <Button Style="{StaticResource AppButton3DCompactDangerStyle}" Content="Material löschen" Click="OnDeleteMaterialClick" Width="220" HorizontalContentAlignment="Left" Margin="0,0,0,10"/>

                    <TextBlock Text="Navigation / Ansicht" Foreground="#B0BEC5" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>
                    <Button Style="{StaticResource AppButton3DCompactPrimaryStyle}" Content="Gebuchte Materialien" Click="OnReservedRestsClick" Width="220" HorizontalContentAlignment="Left" Margin="0,0,0,5"/>
                    <Button Style="{StaticResource AppButton3DCompactSuccessStyle}" Content="Material suchen" Click="OnSearchRestsClick" Width="220" HorizontalContentAlignment="Left" Margin="0,0,0,5"/>
                    <Button Style="{StaticResource AppButton3DCompactWarningStyle}" Content="Niedrige Bestände" Click="OnLowStockClick" Width="220" HorizontalContentAlignment="Left" Margin="0,0,0,5"/>
                    <Button Style="{StaticResource AppButton3DCompactSecondaryStyle}" Content="Aktualisieren" Click="OnRefreshClick" Width="220" HorizontalContentAlignment="Left" Margin="0"/>
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Top" Background="{DynamicResource ThemeWindowBackgroundBrush}" Padding="12" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Aufträge der ausgewählten Kalenderwoche" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                    <Button Grid.Row="0"
                            Grid.Column="1"
                            Content="{Binding AuftragsKwText}"
                            Click="OnAuftragKwAuswahlClick"
                            Style="{StaticResource AppButton3DInfoStyle}"
                            Padding="12,6"
                            MinHeight="30"
                            MinWidth="140"
                            Margin="8,0,0,8"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding AuftragsKwInfoText}" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,8"/>

                    <DataGrid x:Name="AuftraegeGrid"
                              Grid.Row="2"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              ItemsSource="{Binding AuftraegeView}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              MouseDoubleClick="OnAuftraegeGridDoubleClick"
                              PreviewMouseLeftButtonDown="OnAuftraegeGridPreviewMouseLeftButtonDown"
                              MouseMove="OnAuftraegeGridMouseMove"
                              DragOver="OnAuftraegeGridDragOver"
                              Drop="OnAuftraegeGridDrop"
                              AllowDrop="True"
                              RowHeight="28">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEilt}" Value="True">
                                        <Setter Property="Background" Value="#7A1F1F"/>
                                    </DataTrigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#1E4E79"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Auftrag" Binding="{Binding Auftragsnummer}" Width="140"/>
                            <DataGridTextColumn Header="Hinweis" Binding="{Binding EiltText}" Width="70"/>
                            <DataGridTextColumn Header="Bereich" Binding="{Binding Arbeitsplatz}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ArbeitsbereichTextStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="Start" Binding="{Binding ProduktionStartText}" Width="130"/>
                            <DataGridTextColumn Header="Ende" Binding="{Binding ProduktionEndText}" Width="130"/>
                            <DataGridTextColumn Header="Material" Binding="{Binding MaterialAnzeige}" Width="220"/>
                            <DataGridTextColumn Header="Gewicht (kg)" Binding="{Binding GesamtGewichtKg, StringFormat={}{0:0.00}}" Width="100"/>
                            <DataGridTextColumn Header="Produktion" Binding="{Binding ProduktionsDauer}" Width="100"/>
                            <DataGridTextColumn Header="Erstellt" Binding="{Binding ErstelltAm, StringFormat=dd.MM.yyyy}" Width="110"/>
                            <DataGridTemplateColumn Header="PDF" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding PdfDateiname}"
                                                Click="OnAuftragPdfButtonClick"
                                                ToolTip="{Binding PdfPfad}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="#FF9800"
                                                HorizontalContentAlignment="Left"
                                                Padding="0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Top" Background="#0E0E0E" Padding="12" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Suchen:" Foreground="{DynamicResource ThemeForegroundBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Grid.Column="1" x:Name="SearchBox" Background="{DynamicResource ThemeSurfaceBrush}" Foreground="{DynamicResource ThemeForegroundBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" Padding="8,5" TextChanged="OnSearchTextChanged"/>
                    <TextBlock Grid.Column="2" Text="Filter:" Foreground="{DynamicResource ThemeForegroundBrush}" VerticalAlignment="Center" Margin="16,0,12,0"/>
                    <ComboBox Grid.Column="3" x:Name="FormFilterBox" Background="{DynamicResource ThemeSurfaceBrush}" Foreground="{DynamicResource ThemeForegroundBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" SelectionChanged="OnFormFilterChanged">
                        <ComboBoxItem IsSelected="True">Alle</ComboBoxItem>
                        <ComboBoxItem>Blech</ComboBoxItem>
                        <ComboBoxItem>Rohr</ComboBoxItem>
                        <ComboBoxItem>Profil</ComboBoxItem>
                        <ComboBoxItem>GF</ComboBoxItem>
                        <ComboBoxItem>MF</ComboBoxItem>
                        <ComboBoxItem>KF</ComboBoxItem>
                        <ComboBoxItem>Rest</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Grid.Column="4" Text="{Binding SummaryText}" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Top" Background="#0E0E0E" Padding="12">
                <StackPanel>
                    <TextBlock Text="Spaltenfilter (manuell):" Foreground="{DynamicResource ThemeForegroundBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <WrapPanel>
                            <StackPanel Margin="0,0,10,6"><TextBlock Text="Material" Foreground="{DynamicResource ThemeMutedForegroundBrush}" FontSize="11"/><ComboBox x:Name="FilterMaterialBox" Width="140" Height="30" Padding="8,4" Foreground="{DynamicResource ThemeForegroundBrush}" Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" SelectionChanged="OnColumnFilterSelectionChanged"/></StackPanel>
                            <StackPanel Margin="0,0,10,6"><TextBlock Text="Stärke" Foreground="{DynamicResource ThemeMutedForegroundBrush}" FontSize="11"/><ComboBox x:Name="FilterStaerkeBox" Width="100" Height="30" Padding="8,4" Foreground="{DynamicResource ThemeForegroundBrush}" Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" SelectionChanged="OnColumnFilterSelectionChanged"/></StackPanel>
                            <StackPanel Margin="0,0,10,6"><TextBlock Text="Maß" Foreground="{DynamicResource ThemeMutedForegroundBrush}" FontSize="11"/><TextBox x:Name="FilterMassBox" Width="120" Height="30" Padding="8,4" Foreground="{DynamicResource ThemeForegroundBrush}" Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" TextChanged="OnColumnFilterChanged"/></StackPanel>
                            <StackPanel Margin="0,0,10,6"><TextBlock Text="Länge (mm)" Foreground="{DynamicResource ThemeMutedForegroundBrush}" FontSize="11"/><TextBox x:Name="FilterLaengeBox" Width="90" Height="30" Padding="8,4" Foreground="{DynamicResource ThemeForegroundBrush}" Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" TextChanged="OnColumnFilterChanged"/></StackPanel>
                            <StackPanel Margin="0,0,10,6"><TextBlock Text="Lagerort" Foreground="{DynamicResource ThemeMutedForegroundBrush}" FontSize="11"/><TextBox x:Name="FilterLagerortBox" Width="110" Height="30" Padding="8,4" Foreground="{DynamicResource ThemeForegroundBrush}" Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" TextChanged="OnColumnFilterChanged"/></StackPanel>
                            <StackPanel Margin="0,0,10,6"><TextBlock Text="Restnummer" Foreground="{DynamicResource ThemeMutedForegroundBrush}" FontSize="11"/><TextBox x:Name="FilterRestnummerBox" Width="120" Height="30" Padding="8,4" Foreground="{DynamicResource ThemeForegroundBrush}" Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" TextChanged="OnColumnFilterChanged"/></StackPanel>
                            <StackPanel Margin="0,0,10,6"><TextBlock Text="Auftrag" Foreground="{DynamicResource ThemeMutedForegroundBrush}" FontSize="11"/><TextBox x:Name="FilterAuftragBox" Width="120" Height="30" Padding="8,4" Foreground="{DynamicResource ThemeForegroundBrush}" Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" TextChanged="OnColumnFilterChanged"/></StackPanel>
                        </WrapPanel>
                    </ScrollViewer>
                    <TextBlock Text="{Binding SummaryText}" Foreground="{DynamicResource ThemeMutedForegroundBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <DataGrid x:Name="RestMaterialGrid"
                      ItemsSource="{Binding RestMaterialien}"
                      AutoGenerateColumns="False"
                      Margin="10"
                      RowHeight="32"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      MouseDoubleClick="OnGridMouseDoubleClick"
                      PreviewMouseLeftButtonDown="OnGridPreviewMouseLeftButtonDown">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="35">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Material" Binding="{Binding MaterialArt}" Width="90"/>
                    <DataGridTextColumn Header="Legierung" Binding="{Binding Legierung}" Width="100"/>
                    <DataGridTextColumn Header="Oberfläche" Binding="{Binding Oberflaeche}" Width="120"/>
                    <DataGridTextColumn Header="Kategorie" Binding="{Binding Kategorie}" Width="80"/>
                    <DataGridTextColumn Header="Form" Binding="{Binding Form}" Width="60"/>
                    <DataGridTextColumn Header="Stärke" Binding="{Binding Staerke, StringFormat={}{0:0.0} mm}" Width="80"/>
                    <DataGridTextColumn Header="Maß" Binding="{Binding Mass}" Width="120"/>
                    <DataGridTextColumn Header="Länge (mm)" Binding="{Binding LaengeAnzeige}" Width="90"/>
                    <DataGridTextColumn Header="Stück" Binding="{Binding Stueckzahl}" Width="60"/>
                    <DataGridTextColumn Header="Gewicht (kg)" Binding="{Binding GewichtKg, StringFormat={}{0:0.00}}" Width="95"/>
                    <DataGridTextColumn Header="Lagerort" Binding="{Binding Lagerort}" Width="90"/>
                    <DataGridTextColumn Header="Angelegt von" Binding="{Binding AngelegtVon}" Width="120"/>
                    <DataGridTextColumn Header="Geändert von" Binding="{Binding GeaendertVon}" Width="120"/>
                    <DataGridTextColumn Header="Angelegt am" Binding="{Binding Datum, StringFormat=dd.MM.yyyy HH:mm}" Width="145"/>
                    <DataGridTextColumn Header="Geändert am" Binding="{Binding AenderungsDatum, StringFormat=dd.MM.yyyy HH:mm}" Width="145"/>
                    <DataGridTextColumn Header="Restnummer" Binding="{Binding Restnummer}" Width="110"/>
                    <DataGridTextColumn Header="Auftrag" Binding="{Binding AuftragNr}" Width="140"/>
                    <DataGridTextColumn Header="PDF" Binding="{Binding PdfDateiname}" Width="170" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#FF9800"/>
                                <Setter Property="ToolTip" Value="{Binding PdfPfad}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</Window>