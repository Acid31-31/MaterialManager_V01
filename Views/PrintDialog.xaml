<Window x:Class="MaterialManager_V01.Views.PrintDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Druck-Optionen" 
        Height="300" 
        Width="450"
        Background="{DynamicResource ThemeWindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Background="{DynamicResource ThemeWindowBackgroundBrush}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
            <TextBlock Text="?? Druck-Optionen" 
                       Foreground="{DynamicResource ThemeForegroundBrush}" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       Margin="0,0,0,20"/>
            
            <Button Content="?? Bestandsliste drucken" 
                    Click="OnPrintBestand"
                    Style="{StaticResource AppButton3DPrimaryStyle}" 
                    Padding="15,15" 
                    Height="50"
                    FontSize="14"
                    Margin="0,0,0,10"
                    Cursor="Hand"/>
            
            <Button Content="?? Lagerauslastung drucken" 
                    Click="OnPrintLagerAuslastung"
                    Style="{StaticResource AppButton3DSuccessStyle}" 
                    Padding="15,15" 
                    Height="50"
                    FontSize="14"
                    Margin="0,0,0,10"
                    Cursor="Hand"/>
            
            <Button Content="?? Audit-Log drucken" 
                    Click="OnPrintAuditLog"
                    Background="#FF9800" 
                    Foreground="{DynamicResource ThemeForegroundBrush}" 
                    Padding="15,15" 
                    Height="50"
                    FontSize="14"
                    Margin="0,0,0,10"
                    Cursor="Hand"/>
            
            <Button Content="? Abbrechen" 
                    Click="OnCancel"
                    Style="{StaticResource AppButton3DSecondaryStyle}" 
                    Padding="15,10" 
                    MinHeight="40"
                    FontSize="12"/>
        </StackPanel>
    </Grid>
</Window>
