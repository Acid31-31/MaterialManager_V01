<Window x:Class="MaterialManager_V01.Views.AuftragAbschlussAktionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Produktion abgeschlossen"
        Width="760"
        MinWidth="760"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ThemeWindowBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Auftrag abgeschlossen und archiviert" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
            <TextBlock x:Name="InfoTextBlock" Foreground="#D0D0D0" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <Border Background="#252525" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="6" Padding="12">
                <TextBlock x:Name="HinweisTextBlock" Foreground="#B0BEC5" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <WrapPanel x:Name="ButtonPanel" Grid.Row="2" HorizontalAlignment="Left" Margin="0,18,0,0" ItemHeight="42"/>
    </Grid>
</Window>