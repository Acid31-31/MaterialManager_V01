<Window x:Class="MaterialManager_V01.Views.LaserDemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Laser - Restmaterial"
        Height="820"
        Width="1400"
        FontSize="13"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        BorderBrush="#2A2A2A"
        BorderThickness="1"
        Icon="/Assets/app-icon.png"
        Background="#0B0B0B">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="DarkContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkContextMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1976D2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2E2E2E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseTitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#A62216"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Menu">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Icon"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0" ContentSource="Icon" Margin="4,0,6,0" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="20,0,6,0" VerticalAlignment="Center" Foreground="#888"/>
                                <Path Grid.Column="3" x:Name="ArrowPath" Margin="4,0,0,0" VerticalAlignment="Center" Fill="White" Data="M 0 0 L 4 4 L 0 8 Z" Visibility="Collapsed"/>

                                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Right" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" VerticalOffset="-3">
                                    <Border Background="#1A1A1A" BorderBrush="#333" BorderThickness="1" Padding="2">
                                        <ScrollViewer CanContentScroll="True" MaxHeight="400">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="Border" Property="Background" Value="#1F1F1F"/>
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                            </Trigger>
                            <Trigger Property="Role" Value="TopLevelItem">
                                <Setter TargetName="Border" Property="Background" Value="#1F1F1F"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="ArrowPath" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="4,2"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#222"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"/>

                            <ContentPresenter Grid.Column="0"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>

                            <ToggleButton Grid.Column="1"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="#1A1A1A"
                                          BorderBrush="#444"
                                          BorderThickness="1,0,0,0">
                                <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="#111111" BorderBrush="#444" BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0F5AA6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#121212"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="RowBackground" Value="#1A1A1A"/>
            <Setter Property="AlternatingRowBackground" Value="#151515"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="BorderBrush" Value="#333"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="#1B5E20"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AuftragNr}" Value="">
                    <Setter Property="Background" Value="Transparent"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AuftragNr}" Value="{x:Null}">
                    <Setter Property="Background" Value="Transparent"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IstReserviert}" Value="True">
                    <Setter Property="Background" Value="#1B5E20"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E4E79"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="#111111" Height="32">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="/Assets/app-icon.png" Width="16" Height="16" Margin="8,0,10,0" VerticalAlignment="Center"/>

                    <Menu Grid.Column="1" VerticalAlignment="Center" FontSize="13">
                        <MenuItem Header="Datei">
                            <MenuItem Header="Netzwerkordner öffnen" Click="OnOpenNetworkFolder"/>
                            <Separator/>
                            <MenuItem Header="Hauptprogramm" Click="OnOpenMainProgramClick"/>
                            <MenuItem Header="Schließen" Click="OnCloseClick"/>
                        </MenuItem>
                        <MenuItem Header="Bearbeiten">
                            <MenuItem Header="Zurück" InputGestureText="Strg+Z" Click="OnUndoClick"/>
                            <MenuItem Header="Vorwärts" InputGestureText="Strg+Y" Click="OnRedoClick"/>
                            <Separator/>
                            <MenuItem Header="Material bearbeiten" Click="OnEditRestClick"/>
                            <MenuItem Header="Material löschen" Click="OnDeleteReservedClick"/>
                            <MenuItem Header="PDF öffnen" Click="OnOpenPdfClick"/>
                        </MenuItem>
                        <MenuItem Header="Ansicht">
                            <MenuItem Header="Reservierte Reste" Click="OnReservedRestsClick"/>
                        </MenuItem>
                        <MenuItem Header="Hilfe">
                            <MenuItem Header="Programm- &amp; Netzwerkanleitung" Click="OnProgrammHilfe"/>
                            <MenuItem Header="Nach Updates suchen" Click="OnCheckForUpdates"/>
                        </MenuItem>
                    </Menu>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                        <Button Style="{StaticResource TitleBarButtonStyle}" Width="36" Height="26" Margin="0,0,4,0" Content="↶" Click="OnUndoClick" ToolTip="Zurück"/>
                        <Button Style="{StaticResource TitleBarButtonStyle}" Width="36" Height="26" Content="↷" Click="OnRedoClick" ToolTip="Vorwärts"/>
                    </StackPanel>

                    <TextBlock x:Name="LicenseBannerTextBlock"
                               Grid.ColumnSpan="4"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               FontSize="14"
                               IsHitTestVisible="False"
                               TextTrimming="CharacterEllipsis"/>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource TitleBarButtonStyle}" Content="—" Click="OnMinimizeWindow"/>
                        <Button Style="{StaticResource TitleBarButtonStyle}" Content="▢" Click="OnMaximizeRestoreWindow"/>
                        <Button Style="{StaticResource CloseTitleBarButtonStyle}" Content="✕" Click="OnCloseWindow"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Top" Background="#111111" Padding="10" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="/Assets/app-icon.png" Width="16" Height="16" Margin="6,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding WorkspaceTitle}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="{Binding HeaderText}" Foreground="#AAAAAA" Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Right">
                        <TextBlock x:Name="NetworkModeTextBlock"
                                   Foreground="#9E9E9E"
                                   FontSize="10"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,0,2"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="NetworkExcelTextBlock"
                                   Foreground="#9E9E9E"
                                   FontSize="9"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,0,2"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="AutoSyncStatusTextBlock"
                                   Foreground="#81C784"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   Height="16"
                                   Opacity="0"
                                   Margin="0,0,0,6"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Lager"
                                    Click="OnOpenLagerProgramClick"
                                    Background="#00897B"
                                    Foreground="White"
                                    Padding="14,8"
                                    Margin="0,0,8,0"/>
                            <Button Content="Auftragssteuerung"
                                    Click="OnOpenTafelplanungProgramClick"
                                    Background="#1565C0"
                                    Foreground="White"
                                    Padding="14,8"
                                    Margin="0,0,8,0"/>
                            <Button Content="Schließen"
                                    Click="OnCloseClick"
                                    Background="#C42B1C"
                                    Foreground="White"
                                    Padding="14,8"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Top" Background="#1F1F1F" Padding="12">
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" x:Name="MaterialActionPanel">
                        <Button Content="Aktualisieren"
                                Click="OnRefreshClick"
                                Background="#555"
                                Foreground="White"
                                Padding="16,12"
                                Margin="0,0,8,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Top" Background="#0B0B0B" Padding="12" BorderBrush="#333" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="AuftraegeGridRowDefinition" Height="200"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Auftragsverfolgung (5 Wochen bis zur ausgewählten KW)" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                        <Button Content="{Binding NachproduktionButtonText}"
                                Click="OnToggleNachproduktionClick"
                                Background="#455A64"
                                Foreground="White"
                                Padding="12,6"
                                Height="30"
                                MinWidth="140"
                                Margin="0,0,8,8"/>
                        <Button Content="{Binding AuftragsKwText}"
                                Click="OnAuftragKwAuswahlClick"
                                Background="#455A64"
                                Foreground="White"
                                Padding="12,6"
                                Height="30"
                                MinWidth="180"
                                Margin="0,0,0,8"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding AuftragsKwInfoText}" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,8"/>

                    <DataGrid x:Name="AuftraegeGrid"
                              Grid.Row="2"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              ItemsSource="{Binding AuftraegeView}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              MouseDoubleClick="OnAuftraegeGridDoubleClick"
                              RowHeight="28">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEilt}" Value="True">
                                        <Setter Property="Background" Value="#7A1F1F"/>
                                    </DataTrigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#1E4E79"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Auftrag" Binding="{Binding Auftragsnummer}" Width="140"/>
                            <DataGridTextColumn Header="Hinweis" Binding="{Binding EiltText}" Width="70"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="Material" Binding="{Binding MaterialAnzeige}" Width="180"/>
                            <DataGridTextColumn Header="Gewicht (kg)" Binding="{Binding GesamtGewichtKg, StringFormat={}{0:0.00}}" Width="100"/>
                            <DataGridTextColumn Header="Produktion" Binding="{Binding ProduktionsDauer}" Width="100"/>
                            <DataGridTextColumn Header="Angelegt von" Binding="{Binding AngelegtVon}" Width="140"/>
                            <DataGridTextColumn Header="Geändert von" Binding="{Binding GeaendertVon}" Width="140"/>
                            <DataGridTextColumn Header="Erstellt am" Binding="{Binding ErstelltAm, StringFormat=dd.MM.yyyy HH:mm}" Width="150"/>
                            <DataGridTextColumn Header="Geändert am" Binding="{Binding GeaendertAm, StringFormat=dd.MM.yyyy HH:mm}" Width="150"/>
                            <DataGridTemplateColumn Header="PDF" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding PdfDateiname}"
                                                Click="OnAuftragPdfButtonClick"
                                                ToolTip="{Binding PdfPfad}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="#FF9800"
                                                HorizontalContentAlignment="Left"
                                                Padding="0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border x:Name="MaterialFilterBorder" DockPanel.Dock="Top" Background="#0E0E0E" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Suchen Material:" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Grid.Column="1"
                             x:Name="SearchBox"
                             Background="#222"
                             Foreground="White"
                             BorderBrush="#444"
                             Padding="8,5"
                             TextChanged="OnSearchTextChanged"/>
                    <TextBlock Grid.Column="2" Text="Filter:" Foreground="White" VerticalAlignment="Center" Margin="16,0,12,0"/>
                    <ComboBox Grid.Column="3"
                              x:Name="FormFilterBox"
                              Background="#222"
                              Foreground="White"
                              BorderBrush="#444"
                              SelectionChanged="OnFilterChanged">
                        <ComboBoxItem IsSelected="True">Alle</ComboBoxItem>
                        <ComboBoxItem>Blech</ComboBoxItem>
                        <ComboBoxItem>Rohr</ComboBoxItem>
                        <ComboBoxItem>Profil</ComboBoxItem>
                        <ComboBoxItem>GF</ComboBoxItem>
                        <ComboBoxItem>MF</ComboBoxItem>
                        <ComboBoxItem>KF</ComboBoxItem>
                        <ComboBoxItem>Rest</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Grid.Column="4"
                               Text="{Binding SummaryText}"
                               Foreground="#AAAAAA"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"/>
                </Grid>
            </Border>

            <DataGrid x:Name="RestMaterialGrid"
                      ItemsSource="{Binding RestMaterialien}"
                      AutoGenerateColumns="False"
                      Margin="10"
                      RowHeight="32"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      MouseDoubleClick="OnEditRestClick"
                      PreviewMouseLeftButtonDown="OnGridPreviewMouseLeftButtonDown">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="35">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Material" Binding="{Binding MaterialArt}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Legierung" Binding="{Binding Legierung}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Form" Binding="{Binding Form}" Width="60" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Stärke" Binding="{Binding Staerke, StringFormat={}{0:0.0} mm}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Maß" Binding="{Binding Mass}" Width="120" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Stück" Binding="{Binding Stueckzahl}" Width="60" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Gewicht (kg)" Binding="{Binding GewichtKg, StringFormat={}{0:0.00}}" Width="95" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Lagerort" Binding="{Binding Lagerort}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Angelegt von" Binding="{Binding AngelegtVon}" Width="120" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Geändert von" Binding="{Binding GeaendertVon}" Width="120" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Restnummer" Binding="{Binding Restnummer}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Auftrag" Binding="{Binding AuftragNr}" Width="140" IsReadOnly="True"/>
                    <DataGridTextColumn Header="PDF" Binding="{Binding PdfDateiname}" Width="160" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#FF9800"/>
                                <Setter Property="ToolTip" Value="{Binding PdfPfad}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Geändert" Binding="{Binding AenderungsDatum, StringFormat=dd.MM.yyyy}" Width="100" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Image Source="/Assets/logo.png"
               Opacity="0.18"
               Stretch="Uniform"
               Width="820"
               Height="820"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               IsHitTestVisible="False"
               Panel.ZIndex="1"/>
    </Grid>
</Window>