<Window x:Class="MaterialManager_V01.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MaterialManager_V01.Converters"
        xmlns:controls="clr-namespace:MaterialManager_V01.Views.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MaterialManager V01" Height="800" Width="1600" MinWidth="640" MinHeight="480"
        Icon="/Assets/app-icon.png"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="CanResize"
        BorderBrush="{DynamicResource ThemeBorderBrush}"
        BorderThickness="1"
        Background="{DynamicResource ThemeWindowBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <conv:PercentToBrushConverter x:Key="PctToBrush"/>
        
        <Style x:Key="TitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButton3DTitleBarStyle}"/>
        <Style x:Key="CloseTitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButton3DCloseTitleBarStyle}"/>
        
        <!-- MENU & MENUITEM COMPLETE DARK THEME -->
        <Style TargetType="Menu">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Icon"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <ContentPresenter Grid.Column="0" ContentSource="Icon" Margin="4,0,6,0" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="20,0,6,0" VerticalAlignment="Center" Foreground="#888"/>
                                <Path Grid.Column="3" x:Name="ArrowPath" Margin="4,0,0,0" VerticalAlignment="Center" Fill="White" Data="M 0 0 L 4 4 L 0 8 Z" Visibility="Collapsed"/>
                                
                                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Right" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" VerticalOffset="-3">
                                    <Border Background="{DynamicResource ThemeAltSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="2">
                                        <ScrollViewer CanContentScroll="True" MaxHeight="400">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="Border" Property="Background" Value="#1F1F1F"/>
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                            </Trigger>
                            <Trigger Property="Role" Value="TopLevelItem">
                                <Setter TargetName="Border" Property="Background" Value="#1F1F1F"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="ArrowPath" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style TargetType="Separator">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="4,2"/>
        </Style>
        
        <!-- COMBOBOX COMPLETE DARK THEME -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#222"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.ColumnSpan="2" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3"/>

                            <ContentPresenter Grid.Column="0"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>

                            <ToggleButton Grid.Column="1"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{DynamicResource ThemeAltSurfaceBrush}"
                                          BorderBrush="{DynamicResource ThemeBorderBrush}"
                                          BorderThickness="1,0,0,0">
                                <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{DynamicResource ThemeAltSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- DATAGRID STYLES -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#121212"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="RowBackground" Value="#1A1A1A"/>
            <Setter Property="AlternatingRowBackground" Value="#151515"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="BorderBrush" Value="#333"/>
        </Style>
        
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="#1B5E20"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AuftragNr}" Value="">
                    <Setter Property="Background" Value="Transparent"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AuftragNr}" Value="{x:Null}">
                    <Setter Property="Background" Value="Transparent"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IstReserviert}" Value="True">
                    <Setter Property="Background" Value="#1B5E20"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                    <Setter Property="Background" Value="#1B5E20"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource ThemeSurfaceBrush}" Height="46" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0"
                           Source="pack://application:,,,/Assets/app-icon.png"
                           Height="18"
                           Width="18"
                           Margin="8,0,10,0"
                           VerticalAlignment="Center"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True"
                           shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                    <Menu Grid.Column="1"
                          VerticalAlignment="Center"
                          FontSize="13"
                          shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <MenuItem Header="Datei">
                            <MenuItem Header="Material neu" Click="OnMaterialNeu"/>
                            <Separator/>
                            <MenuItem Header="Import" Click="OnImport"/>
                            <MenuItem Header="Export" Click="OnExport"/>
                            <Separator/>
                            <MenuItem Header="Netzwerk‑Einstellungen" Click="OnNetzwerkEinstellungen"/>
                            <MenuItem Header="Netzwerkordner öffnen" Click="OnOpenNetworkFolder"/>
                            <Separator/>
                            <MenuItem Header="Startseite" Click="OnOpenStartProgramClick"/>
                            <MenuItem Header="Beenden" Click="OnBeenden"/>
                        </MenuItem>
                        <MenuItem Header="Bearbeiten">
                            <MenuItem Header="↶ Rückgängig (Ctrl+Z)" Click="OnUndo"/>
                            <MenuItem Header="↷ Wiederherstellen" Click="OnRedo" IsEnabled="False"/>
                            <Separator/>
                            <MenuItem Header="Löschen" Click="OnMaterialLoeschen"/>
                            <Separator/>
                            <MenuItem Header="Tafel verbrauchen" Click="OnTafelVerbrauchen"/>
                        </MenuItem>
                        <MenuItem Header="Ansicht">
                            <MenuItem Header="Inventur" Click="OnInventur"/>
                            <MenuItem Header="Statistik" Click="OnStatistik"/>
                            <MenuItem Header="Reste suchen" Click="OnResteSuchen"/>
                            <MenuItem Header="🔖 Reservierte Reste" Click="OnReservierteReste"/>
                            <MenuItem Header="Rohrezuschnitt optimieren" Click="OnRohrZuschnitt"/>
                        </MenuItem>
                        <MenuItem Header="Hilfe">
                            <MenuItem Header="📘 Programm- &amp; Netzwerkanleitung" Click="OnProgrammHilfe"/>
                            <Separator/>
                            <MenuItem Header="📄 Materialliste drucken" Click="OnPrintMaterialList"/>
                            <MenuItem Header="📊 Als Excel exportieren" Click="OnExportExcel"/>
                            <MenuItem Header="📋 Als CSV exportieren" Click="OnExportCSV"/>
                            <Separator/>
                            <MenuItem Header="Lizenz aktivieren" Click="OnLizenzAktivieren"/>
                            <MenuItem Header="Nach Updates suchen" Click="OnCheckForUpdates"/>
                        </MenuItem>
                    </Menu>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Margin="0,0,10,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitleBarButtonStyle}" Width="36" MinHeight="26" Margin="0,0,4,0" Click="OnUndo" ToolTip="Rückgängig (Ctrl+Z)">
                            <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </Button>
                        <Button Style="{StaticResource TitleBarButtonStyle}" Width="36" MinHeight="26" Margin="0,0,8,0" Click="OnRedo" ToolTip="Wiederherstellen (Ctrl+Y)">
                            <TextBlock Text="&#xE7A6;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </Button>
                        <StackPanel Orientation="Vertical" Margin="10,0,0,0">
                            <TextBlock Text="{Binding NetzwerkStatusText}"
                                       Foreground="{Binding NetzwerkStatusBrush}"
                                       FontSize="10"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,10,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding ExcelSyncStatusText}"
                                       Foreground="#9E9E9E"
                                       FontSize="9"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,10,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.ColumnSpan="4"
                               Text="{Binding LicenseTrialDisplayText}"
                               Foreground="{Binding LicenseTrialDisplayBrush}"
                               FontWeight="Bold"
                               FontSize="14"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               IsHitTestVisible="False"/>

                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitleBarButtonStyle}" Click="OnMinimizeWindow">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                        <Button Style="{StaticResource TitleBarButtonStyle}" Click="OnMaximizeRestoreWindow">
                            <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                        <Button Style="{StaticResource CloseTitleBarButtonStyle}" Click="OnCloseWindow">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Top" Background="{DynamicResource ThemeSurfaceBrush}" Height="58">
                <Grid Margin="8,6,8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                        <controls:ModuleNavigationButtons ShowHauptprogramm="False"
                                                            StartseiteClick="OnOpenStartProgramClick"
                                                            Margin="0,0,8,0"/>
                        <Button Click="OnCheckForUpdates" Style="{StaticResource AppButton3DSecondaryStyle}" Padding="10,6" Margin="0,0,5,0" ToolTip="Nach Programm-Updates suchen">
                            <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                        </Button>
                    </StackPanel>
                    
                    <DockPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ComboBox x:Name="FormFilterBox" Width="100" Margin="0,0,8,0" SelectionChanged="OnMainFilterChanged">
                                <ComboBoxItem IsSelected="True">Alle</ComboBoxItem>
                                <ComboBoxItem>Blech</ComboBoxItem>
                                <ComboBoxItem>Rohr</ComboBoxItem>
                                <ComboBoxItem>Profil</ComboBoxItem>
                                <ComboBoxItem>GF</ComboBoxItem>
                                <ComboBoxItem>MF</ComboBoxItem>
                                <ComboBoxItem>KF</ComboBoxItem>
                                <ComboBoxItem>Rest</ComboBoxItem>
                            </ComboBox>
                            <ComboBox x:Name="WeightModeBox" Width="100" Margin="0,0,8,0" SelectionChanged="OnWeightModeChanged">
                                <ComboBoxItem IsSelected="True">Gesamt</ComboBoxItem>
                                <ComboBoxItem>Gefiltert</ComboBoxItem>
                            </ComboBox>
                            <Button Click="OnMaterialLoeschen" Style="{StaticResource AppButton3DDangerStyle}" Padding="12,6" Margin="0,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Löschen" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBox x:Name="SearchBox" Background="{DynamicResource ThemeSurfaceBrush}" Foreground="{DynamicResource ThemeForegroundBrush}" Padding="6,4" TextChanged="OnMainSearchChanged" VerticalContentAlignment="Center" Height="28" FontSize="13" Margin="0,0,10,0" Width="320"/>
                    </DockPanel>
                </Grid>
            </Border>
            
            <Border DockPanel.Dock="Top" Background="#0E0E0E" Padding="8">
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Click="OnMaterialNeu" Style="{StaticResource AppButton3DSuccessStyle}" Width="140" Height="80" Margin="0,0,8,8" Padding="10,8">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="#C8E6C9" HorizontalAlignment="Center"/>
                            <TextBlock Text="Material neu" Foreground="{DynamicResource ThemeForegroundBrush}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="11"/>
                        </StackPanel>
                    </Button>

                    <Button Click="OnOpenLagerView" Style="{StaticResource AppButton3DPurpleStyle}" Width="150" Height="80" Margin="0,0,8,8" Padding="10,8">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="#E1BEE7" HorizontalAlignment="Center"/>
                            <TextBlock Text="Lager" Foreground="{DynamicResource ThemeForegroundBrush}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button Click="OnOpenTafelplanungView" Style="{StaticResource AppButton3DTealStyle}" Width="170" Height="80" Margin="0,0,8,8" Padding="10,8">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="#B2DFDB" HorizontalAlignment="Center"/>
                            <TextBlock Text="Auftragssteuerung" Foreground="{DynamicResource ThemeForegroundBrush}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Click="OnOpenLaserView" Style="{StaticResource AppButton3DSuccessStyle}" Width="140" Height="80" Margin="0,0,8,8" Padding="10,8">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="#C8E6C9" HorizontalAlignment="Center"/>
                            <TextBlock Text="Laser" Foreground="{DynamicResource ThemeForegroundBrush}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button Click="OnOpenKundenMaterialView" Style="{StaticResource AppButton3DPrimaryStyle}" Width="170" Height="80" Margin="0,0,8,8" Padding="10,8">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="#BBDEFB" HorizontalAlignment="Center"/>
                            <TextBlock Text="Kunden Lager" Foreground="{DynamicResource ThemeForegroundBrush}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    
                    <Border Background="{DynamicResource ThemeAltSurfaceBrush}" CornerRadius="5" Padding="12" Margin="0,0,8,8" Width="200" Height="75">
                        <StackPanel>
                            <TextBlock Text="Gesamtgewicht" Foreground="{DynamicResource ThemeForegroundBrush}" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Text="{Binding GesamtGewichtText}" Foreground="#4CAF50" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <Button Click="OnRegalauslastungClick" Style="{StaticResource AppButton3DInfoPanelStyle}" Width="200">
                        <StackPanel>
                            <TextBlock Text="Regalauslastung" Foreground="{DynamicResource ThemeForegroundBrush}" FontWeight="Bold" FontSize="11"/>
                            <ProgressBar Value="{Binding DurchschnittAuslastung}" Minimum="0" Maximum="100" Height="10" Margin="0,4,0,3" Background="#2A2A2A" Foreground="#00A651"/>
                            <TextBlock Text="{Binding AuslastungText}" Foreground="#AAA" FontSize="10" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Button>

                    <Button Click="OnEuPaletteClick" Style="{StaticResource AppButton3DInfoPanelStyle}" Width="230">
                        <StackPanel>
                            <TextBlock Text="EU Palette (Rest Material)" Foreground="{DynamicResource ThemeForegroundBrush}" FontWeight="Bold" FontSize="11"/>
                            <ProgressBar Value="{Binding EuPalettePct}" Minimum="0" Maximum="100" Height="10" Margin="0,4,0,3" Background="#2A2A2A" Foreground="#FF9800"/>
                            <TextBlock Text="{Binding EuPaletteDisplayText}" Foreground="#AAA" FontSize="10" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Click="OnNiedrigeBestaendeClick" Style="{StaticResource AppButton3DWarningStyle}" Width="180" Height="75" Margin="0,0,8,8" Padding="12,8" HorizontalContentAlignment="Stretch">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#FFE0B2" Margin="0,0,6,0"/>
                                <TextBlock Text="Niedrige Bestände" Foreground="{DynamicResource ThemeForegroundBrush}" FontWeight="Bold" FontSize="11"/>
                            </StackPanel>
                            <TextBlock Text="{Binding NiedrigeBestaendeText}" Foreground="{Binding NiedrigeBastaendeFarbe}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Click="OnReservierteReste" Style="{StaticResource AppButton3DSuccessStyle}" Width="180" Height="75" Margin="0,0,8,8" Padding="12,8" HorizontalContentAlignment="Stretch">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#C8E6C9" Margin="0,0,6,0"/>
                                <TextBlock Text="Reservierte Reste" Foreground="{DynamicResource ThemeForegroundBrush}" FontWeight="Bold" FontSize="11"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ReservierteResteCount}" Foreground="#C8E6C9" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Click="OnResteSuchen" Style="{StaticResource AppButton3DSuccessStyle}" Width="160" Height="85" Margin="0,0,8,8" Padding="10,8">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="#C8E6C9" HorizontalAlignment="Center"/>
                            <TextBlock Text="Reste suchen" Foreground="{DynamicResource ThemeForegroundBrush}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button Click="OnRohrZuschnitt" Style="{StaticResource AppButton3DTealStyle}" Width="180" Height="85" Margin="0,0,8,8" Padding="10,8">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE9A6;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="#B2DFDB" HorizontalAlignment="Center"/>
                            <TextBlock Text="Rohrzuschnitt" Foreground="{DynamicResource ThemeForegroundBrush}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button Click="OnOnlineUsersClick" x:Name="OnlineUsersBorder" Style="{StaticResource AppButton3DInfoPanelStyle}" Width="220" Height="85">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#BBDEFB" Margin="0,0,6,0"/>
                                <TextBlock Text="Online Jetzt" Foreground="{DynamicResource ThemeForegroundBrush}" FontWeight="Bold" FontSize="11"/>
                            </StackPanel>
                            <TextBlock x:Name="OnlineUsersDisplay" Text="● hoelz" Foreground="#4CAF50" FontSize="13" FontWeight="Bold" Margin="0,8,0,0" TextWrapping="Wrap" MaxHeight="60"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Border>
            
            <DataGrid x:Name="MaterialGrid"
                      ItemsSource="{Binding Materialien}"
                      AutoGenerateColumns="False"
                      Margin="10"
                      CanUserAddRows="False"
                      MouseDoubleClick="OnMaterialBearbeiten"
                      PreviewMouseLeftButtonDown="OnGridPreviewMouseLeftButtonDown"
                      RowHeight="32">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="35">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center" Checked="OnSelectAllChecked" Unchecked="OnSelectAllUnchecked"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Click="CheckBox_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Material" Binding="{Binding MaterialArt}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Legierung" Binding="{Binding Legierung}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Oberfläche" Binding="{Binding Oberflaeche}" Width="120" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Güte" Binding="{Binding Guete}" Width="70" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Form" Binding="{Binding Form}" Width="60" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Stärke" Binding="{Binding Staerke, StringFormat={}{0:0.0} mm}" Width="70" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Maß" Binding="{Binding Mass}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Stück" Binding="{Binding Stueckzahl}" Width="50" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Gewicht (kg)" Binding="{Binding GewichtKg, StringFormat={}{0:0.00} kg}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Lagerort" Binding="{Binding Lagerort}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Restnummer" Binding="{Binding Restnummer}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Datum" Binding="{Binding Datum, StringFormat=dd.MM.yyyy}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Geändert" Binding="{Binding AenderungsDatum, StringFormat=dd.MM.yyyy}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Angelegt von" Binding="{Binding AngelegtVon}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Geändert von" Binding="{Binding GeaendertVon}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Auftrag" Binding="{Binding AuftragNr}" Width="130" IsReadOnly="True"/>
                    <DataGridTextColumn Header="PDF" Binding="{Binding PdfDateiname}" Width="150" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#FF9800"/>
                                <Setter Property="ToolTip" Value="{Binding PdfPfad}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Lieferant" Binding="{Binding Lieferant}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Lieferschein-Nr" Binding="{Binding LieferscheinNr}" Width="110" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
            
            <!-- ✅ EXPANDABLES ONLINE-USERS POPUP -->
            <Popup x:Name="OnlineUsersPopup" IsOpen="False" Placement="Mouse" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{DynamicResource ThemeAltSurfaceBrush}" BorderBrush="#4CAF50" BorderThickness="2" CornerRadius="8" Padding="15" Width="280">
                    <StackPanel>
                        <TextBlock Text="👥 Online Benutzer" Foreground="{DynamicResource ThemeForegroundBrush}" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                            <ListBox x:Name="OnlineUsersList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ThemeForegroundBrush}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="#4CAF50" FontSize="12" Margin="0,5,0,5"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                        <TextBlock Text="(Klick irgendwo zum Schließen)" Foreground="#888" FontSize="9" Margin="0,10,0,0" FontStyle="Italic"/>
                    </StackPanel>
                </Border>
            </Popup>
        </DockPanel>
    </Grid>
</Window>

