<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>MaterialManager_V01</AssemblyName>
    <RootNamespace>MaterialManager_V01</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>

    <!-- WICHTIG: Manifest = KEINE Admin-Rechte! -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- App-Informationen (reduziert SmartScreen-Warnungen) -->
    <Version>1.2.1</Version>
    <FileVersion>1.2.1.0</FileVersion>
    <AssemblyVersion>1.2.1.0</AssemblyVersion>
    <InformationalVersion>1.2.1</InformationalVersion>
    <Product>MaterialManager V01</Product>
    <Company>Alexander Hoelzer</Company>
    <Description>Materialverwaltung für Blechlager - Vollversion mit Lizenzierung</Description>
    <Copyright>Copyright © 2026 Alexander Hoelzer</Copyright>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- Self-Contained Settings für USB-Distribution -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    
    <!-- Code-Signing Vorbereitung -->
    <SignAssembly>false</SignAssembly>
    <DelaySign>false</DelaySign>
  </PropertyGroup>

  <!-- USB Publication Profile -->
  <PropertyGroup Condition="'$(PublishProfile)' == 'USBVersion'">
    <PublishDir>.\USB_Package\</PublishDir>
    <StripSymbols>true</StripSymbols>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\logo.png" />
    <None Remove="Assets\app.ico" />
    <None Remove="Assets\app-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="bin\Demo\README_DEMO.txt" />
    <Content Include="bin\DEMO_Email_Vorlage.txt" />
    <Content Include="bin\INSTALLATION_ANLEITUNG_USB.txt" />
    <Content Include="bin\PAKET_UEBERSICHT.txt" />
    <Content Include="bin\USB_Version\KONKURRENZ_VERGLEICH.txt" />
    <Content Include="bin\USB_Version\PAKET_UEBERSICHT.txt" />
    <Content Include="bin\USB_Version\PREIS_KALKULATION_10_MITARBEITER.txt" />
    <Content Include="bin\USB_Version\README_INSTALLATION.txt" />
    <Content Include="bin\USB_Version\USB_INSTALLATION.txt" />
    <Content Include="bin\USB_Version\WERT_ANALYSE.txt" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".github\copilot-instructions.md" />
    <None Include=".github\workflows\auto-release.yml" />
    <None Include="bin\USB_Version\autorun.inf" />
    <None Include="bin\USB_Version\START.bat" />
    <None Include="Installer_Source\MaterialManager_Setup.vdproj" />
    <None Include="Installer_Source\UpdateInstaller.csproj" />
    <None Include="MaterialManager.sln" />
    <None Include="Tools\LicenseGenerator.csproj" />
    <None Include="USB_Installation_Helper\USB_Installation_Helper.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.8" />
    <PackageReference Include="QRCoder" Version="1.4.3" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <Page Update="Views\ResteAuswahlDialog.xaml" />
    <Compile Update="Views\ResteAuswahlDialog.xaml.cs">
      <DependentUpon>ResteAuswahlDialog.xaml</DependentUpon>
    </Compile>
    <Page Update="Views\ResteReservierungDialog.xaml" />
    <Compile Update="Views\ResteReservierungDialog.xaml.cs">
      <DependentUpon>ResteReservierungDialog.xaml</DependentUpon>
    </Compile>
    <Page Update="Views\NetzwerkEinstellungenDialog.xaml" />
    <Compile Update="Views\NetzwerkEinstellungenDialog.xaml.cs">
      <DependentUpon>NetzwerkEinstellungenDialog.xaml</DependentUpon>
    </Compile>
    <Page Update="Views\ProgrammHilfeDialog.xaml" />
    <Compile Update="Views\ProgrammHilfeDialog.xaml.cs">
      <DependentUpon>ProgrammHilfeDialog.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Installer\" />
    <Folder Include="Properties\" />
  </ItemGroup>

  <!-- WICHTIG: Exclude archivierte & Backup-Verzeichnisse vom Build -->
  <ItemGroup>
    <Compile Remove="_ARCHIVE_TO_REVIEW\**\*.cs" />
    <Compile Remove="Backup*\**\*.cs" />
    <Compile Remove="Installer_Source\UpdateInstaller.cs" />
    <Compile Remove="Installer_Source\obj\**\*.cs" />
    <Compile Remove="Installer_Source\bin\**\*.cs" />
    <Compile Remove="Tools\LicenseGenerator.cs" />
    <Compile Remove="Tools\obj\**\*.cs" />
    <Compile Remove="Tools\bin\**\*.cs" />
    <Page Remove="_ARCHIVE_TO_REVIEW\**\*.xaml" />
    <Page Remove="Backup*\**\*.xaml" />
    <ApplicationDefinition Remove="_ARCHIVE_TO_REVIEW\**\*.xaml" />
    <ApplicationDefinition Remove="Backup*\**\*.xaml" />
    <None Remove="_ARCHIVE_TO_REVIEW\**\*.*" />
    <None Remove="Backup*\**\*.*" />
    <None Remove="Installer_Source\obj\**\*.*" />
    <None Remove="Installer_Source\bin\**\*.*" />
  </ItemGroup>

</Project>

































