<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="ModuleNavButtonBaseStyle" TargetType="Button" BasedOn="{StaticResource AppButton3DBaseStyle}">
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinWidth" Value="148"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>

    <Style x:Key="ModuleNavStartButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButton3DCompactInfoStyle}">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="MinWidth" Value="148"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="ToolTip" Value="Zurück zur Modus-Auswahl"/>
    </Style>

    <Style x:Key="ModuleNavMainButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButton3DCompactPrimaryStyle}">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="MinWidth" Value="148"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="ToolTip" Value="Zur Materialverwaltung"/>
    </Style>

    <Style x:Key="ModuleNavBarBorderStyle" TargetType="Border">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#161616" Offset="0"/>
                    <GradientStop Color="#101010" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="#455A64"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="Padding" Value="14,10"/>
    </Style>

    <DataTemplate x:Key="ModuleNavStartButtonContentTemplate">
        <StackPanel Orientation="Horizontal">
            <Border Width="22" Height="22" CornerRadius="4" Margin="0,0,8,0" VerticalAlignment="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFFF" Offset="0"/>
                        <GradientStop Color="#CFD8DC" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="🏠" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Startseite" VerticalAlignment="Center" Foreground="{DynamicResource ThemeForegroundBrush}" FontWeight="SemiBold"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ModuleNavMainButtonContentTemplate">
        <StackPanel Orientation="Horizontal">
            <Border Width="22" Height="22" CornerRadius="4" Margin="0,0,8,0" VerticalAlignment="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFFF" Offset="0"/>
                        <GradientStop Color="#BBDEFB" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Image Source="/Assets/app-icon.png" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Hauptprogramm" VerticalAlignment="Center" Foreground="{DynamicResource ThemeForegroundBrush}" FontWeight="SemiBold"/>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
