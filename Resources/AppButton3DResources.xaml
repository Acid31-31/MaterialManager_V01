    <ControlTemplate x:Key="AppButton3DInsetTemplate" TargetType="Button">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="OuterBezel"
                    CornerRadius="7"
                    Padding="2,2,2,2"
                    Background="{StaticResource BtnInsetOuterBezel}"
                    BorderBrush="{StaticResource BtnInsetOuterBezelBorder}"
                    BorderThickness="1">
                <Border x:Name="InnerRecess" CornerRadius="5" Background="#030405">
                    <Border x:Name="RecessWall"
                            CornerRadius="4"
                            Background="#06080A"
                            BorderThickness="1"
                            BorderBrush="#000000">
                        <Border x:Name="BacklightPanel"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                ClipToBounds="True">
                            <Grid>
                                <Border x:Name="InnerGlow" CornerRadius="3" VerticalAlignment="Bottom" Height="12" IsHitTestVisible="False" Opacity="0.55">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                            <GradientStop Color="#55FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border x:Name="TopVignette" CornerRadius="3,3,0,0" VerticalAlignment="Top" Height="6" IsHitTestVisible="False" Opacity="0.35">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#66000000" Offset="0"/><GradientStop Color="#00000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                    </Border>
                </Border>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="BacklightPanel" Property="Opacity" Value="1"/>
                <Setter TargetName="InnerGlow" Property="Opacity" Value="0.78"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="BacklightPanel" Property="Margin" Value="0,1,0,-1"/>
                <Setter TargetName="RecessWall" Property="BorderThickness" Value="2,2,2,1"/>
                <Setter TargetName="InnerGlow" Property="Opacity" Value="0.32"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="OuterBezel" Property="Opacity" Value="0.42"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

