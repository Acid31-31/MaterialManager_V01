    <LinearGradientBrush x:Key="Btn3DSecondaryPressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#434B54" Offset="0"/><GradientStop Color="#353C44" Offset="0.45"/><GradientStop Color="#22282E" Offset="1"/>
