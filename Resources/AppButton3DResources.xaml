    <Style x:Key="AppButton3DModuleTileStyle" TargetType="Button" BasedOn="{StaticResource AppButton3DSecondaryStyle}">
        <Setter Property="Width" Value="150"/>
        <Setter Property="Height" Value="80"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="AppButton3DInfoPanelStyle" TargetType="Button" BasedOn="{StaticResource AppButton3DSecondaryStyle}">
        <Setter Property="Height" Value="75"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    </Style>

    <!-- Standard für alle Buttons ohne expliziten Style -->
    <Style TargetType="Button" BasedOn="{StaticResource AppButton3DSecondaryStyle}"/>

</ResourceDictionary>
