    <Style x:Key="AppButton3DLargePurpleStyle" TargetType="Button" BasedOn="{StaticResource AppButton3DPurpleStyle}">
        <Setter Property="Height" Value="150"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style x:Key="AppButton3DLargeIndigoStyle" TargetType="Button" BasedOn="{StaticResource AppButton3DBaseStyle}">
        <Setter Property="Background" Value="{StaticResource Btn3DIndigoNormal}"/>
        <Setter Property="Height" Value="150"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Btn3DIndigoHover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{StaticResource Btn3DIndigoPressed}"/></Trigger>
        </Style.Triggers>
