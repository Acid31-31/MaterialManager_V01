    <LinearGradientBrush x:Key="Btn3DIndigoPressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3949AB" Offset="0"/><GradientStop Color="#303F9F" Offset="0.45"/><GradientStop Color="#1A237E" Offset="1"/>
