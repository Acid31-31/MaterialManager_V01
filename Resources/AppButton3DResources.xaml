                <Setter TargetName="RecessWall" Property="BorderThickness" Value="3,3,3,2"/>
                <Setter TargetName="InnerGlow" Property="Opacity" Value="0.32"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="OuterBezel" Property="Opacity" Value="0.42"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="AppButton3DTemplate" TargetType="Button">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="DropShadow" Margin="0,2,0,0" CornerRadius="6" Background="#050505" Opacity="0.5"/>
            <Border x:Name="ButtonFace" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                <Border x:Name="BevelBorder" CornerRadius="6" BorderThickness="1,1,1,2">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#C8D0D6" Offset="0"/>
                            <GradientStop Color="#505860" Offset="0.55"/>
                            <GradientStop Color="#1A2024" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border x:Name="InnerHighlight" CornerRadius="5" Margin="1,1,1,2" BorderThickness="0,1,0,0" BorderBrush="#99FFFFFF" Opacity="0.32">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                </Border>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="DropShadow" Property="Opacity" Value="0.65"/>
                <Setter TargetName="InnerHighlight" Property="Opacity" Value="0.48"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonFace" Property="Margin" Value="0,2,0,-2"/>
                <Setter TargetName="DropShadow" Property="Opacity" Value="0.22"/>
                <Setter TargetName="DropShadow" Property="Margin" Value="0,1,0,0"/>
                <Setter TargetName="BevelBorder" Property="BorderThickness" Value="1,2,1,1"/>
                <Setter TargetName="InnerHighlight" Property="Opacity" Value="0.14"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonFace" Property="Opacity" Value="0.48"/>
                <Setter TargetName="DropShadow" Property="Opacity" Value="0.15"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="AppButton3DTitleBarTemplate" TargetType="Button">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="ButtonFace" CornerRadius="3" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
