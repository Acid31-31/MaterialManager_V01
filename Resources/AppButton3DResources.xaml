    <LinearGradientBrush x:Key="Btn3DPurplePressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#7B1FA2" Offset="0"/><GradientStop Color="#6A1B9A" Offset="0.45"/><GradientStop Color="#4A148C" Offset="1"/>
