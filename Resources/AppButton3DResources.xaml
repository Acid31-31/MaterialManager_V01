    <!-- Info / Blue-Gray -->
    <LinearGradientBrush x:Key="Btn3DInfoNormal" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#78909C" Offset="0"/><GradientStop Color="#455A64" Offset="0.45"/><GradientStop Color="#37474F" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Btn3DInfoHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#90A4AE" Offset="0"/><GradientStop Color="#546E7A" Offset="0.45"/><GradientStop Color="#455A64" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Btn3DInfoPressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#546E7A" Offset="0"/><GradientStop Color="#455A64" Offset="0.45"/><GradientStop Color="#2C393F" Offset="1"/>
    </LinearGradientBrush>

    <!-- Title bar -->
    <LinearGradientBrush x:Key="Btn3DTitleBarNormal" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3A3A3A" Offset="0"/><GradientStop Color="#252525" Offset="0.45"/><GradientStop Color="#181818" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Btn3DTitleBarHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#505050" Offset="0"/><GradientStop Color="#383838" Offset="0.45"/><GradientStop Color="#242424" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Btn3DTitleBarPressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2A2A2A" Offset="0"/><GradientStop Color="#1E1E1E" Offset="0.45"/><GradientStop Color="#121212" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Btn3DCloseHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF6659" Offset="0"/><GradientStop Color="#C42B1C" Offset="0.45"/><GradientStop Color="#962019" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Btn3DClosePressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D32F2F" Offset="0"/><GradientStop Color="#A62216" Offset="0.45"/><GradientStop Color="#7A1810" Offset="1"/>
    </LinearGradientBrush>

    <ControlTemplate x:Key="AppButton3DTemplate" TargetType="Button">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="DropShadow" Margin="0,2,0,0" CornerRadius="6" Background="#050505" Opacity="0.5"/>
            <Border x:Name="ButtonFace" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                <Border x:Name="BevelBorder" CornerRadius="6" BorderThickness="1,1,1,2">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#C8D0D6" Offset="0"/>
                            <GradientStop Color="#505860" Offset="0.55"/>
                            <GradientStop Color="#1A2024" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border x:Name="InnerHighlight" CornerRadius="5" Margin="1,1,1,2" BorderThickness="0,1,0,0" BorderBrush="#99FFFFFF" Opacity="0.32">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                </Border>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="DropShadow" Property="Opacity" Value="0.65"/>
                <Setter TargetName="InnerHighlight" Property="Opacity" Value="0.48"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonFace" Property="Margin" Value="0,2,0,-2"/>
                <Setter TargetName="DropShadow" Property="Opacity" Value="0.22"/>
                <Setter TargetName="DropShadow" Property="Margin" Value="0,1,0,0"/>
                <Setter TargetName="BevelBorder" Property="BorderThickness" Value="1,2,1,1"/>
                <Setter TargetName="InnerHighlight" Property="Opacity" Value="0.14"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonFace" Property="Opacity" Value="0.48"/>
                <Setter TargetName="DropShadow" Property="Opacity" Value="0.15"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="AppButton3DTitleBarTemplate" TargetType="Button">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="ButtonFace" CornerRadius="3" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                <Border x:Name="BevelBorder" CornerRadius="3" BorderThickness="1,1,1,1" BorderBrush="#555555">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="BevelBorder" Property="BorderBrush" Value="#888888"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonFace" Property="Margin" Value="0,1,0,-1"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="AppButton3DBaseStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Btn3DSecondaryNormal}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template" Value="{StaticResource AppButton3DTemplate}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Btn3DSecondaryHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Btn3DSecondaryPressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AppButton3DPrimaryStyle" TargetType="Button" BasedOn="{StaticResource AppButton3DBaseStyle}">
        <Setter Property="Background" Value="{StaticResource Btn3DPrimaryNormal}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Btn3DPrimaryHover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{StaticResource Btn3DPrimaryPressed}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="AppButton3DSuccessStyle" TargetType="Button" BasedOn="{StaticResource AppButton3DBaseStyle}">
        <Setter Property="Background" Value="{StaticResource Btn3DSuccessNormal}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Btn3DSuccessHover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{StaticResource Btn3DSuccessPressed}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="AppButton3DTealStyle" TargetType="Button" BasedOn="{StaticResource AppButton3DBaseStyle}">
        <Setter Property="Background" Value="{StaticResource Btn3DTealNormal}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Btn3DTealHover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{StaticResource Btn3DTealPressed}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="AppButton3DDangerStyle" TargetType="Button" BasedOn="{StaticResource AppButton3DBaseStyle}">
        <Setter Property="Background" Value="{StaticResource Btn3DDangerNormal}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Btn3DDangerHover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{StaticResource Btn3DDangerPressed}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="AppButton3DWarningStyle" TargetType="Button" BasedOn="{StaticResource AppButton3DBaseStyle}">
        <Setter Property="Background" Value="{StaticResource Btn3DWarningNormal}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Btn3DWarningHover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{StaticResource Btn3DWarningPressed}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="AppButton3DInfoStyle" TargetType="Button" BasedOn="{StaticResource AppButton3DBaseStyle}">
        <Setter Property="Background" Value="{StaticResource Btn3DInfoNormal}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Btn3DInfoHover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{StaticResource Btn3DInfoPressed}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="AppButton3DSecondaryStyle" TargetType="Button" BasedOn="{StaticResource AppButton3DBaseStyle}"/>

    <Style x:Key="AppButton3DCompactPrimaryStyle" TargetType="Button" BasedOn="{StaticResource AppButton3DPrimaryStyle}">
        <Setter Property="Padding" Value="10,5"/><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="28"/>
    </Style>
    <Style x:Key="AppButton3DCompactSuccessStyle" TargetType="Button" BasedOn="{StaticResource AppButton3DSuccessStyle}">
        <Setter Property="Padding" Value="10,5"/><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="28"/>
    </Style>
    <Style x:Key="AppButton3DCompactTealStyle" TargetType="Button" BasedOn="{StaticResource AppButton3DTealStyle}">
        <Setter Property="Padding" Value="10,5"/><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="28"/>
    </Style>
    <Style x:Key="AppButton3DCompactDangerStyle" TargetType="Button" BasedOn="{StaticResource AppButton3DDangerStyle}">
        <Setter Property="Padding" Value="10,5"/><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="28"/>
    </Style>
    <Style x:Key="AppButton3DCompactWarningStyle" TargetType="Button" BasedOn="{StaticResource AppButton3DWarningStyle}">
        <Setter Property="Padding" Value="10,5"/><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="28"/>
    </Style>
    <Style x:Key="AppButton3DCompactInfoStyle" TargetType="Button" BasedOn="{StaticResource AppButton3DInfoStyle}">
        <Setter Property="Padding" Value="10,5"/><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="28"/>
    </Style>
    <Style x:Key="AppButton3DCompactSecondaryStyle" TargetType="Button" BasedOn="{StaticResource AppButton3DSecondaryStyle}">
        <Setter Property="Padding" Value="10,5"/><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="28"/>
    </Style>

    <Style x:Key="AppButton3DTitleBarStyle" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Background" Value="{StaticResource Btn3DTitleBarNormal}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template" Value="{StaticResource AppButton3DTitleBarTemplate}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Btn3DTitleBarHover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{StaticResource Btn3DTitleBarPressed}"/></Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AppButton3DCloseTitleBarStyle" TargetType="Button" BasedOn="{StaticResource AppButton3DTitleBarStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Btn3DCloseHover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{StaticResource Btn3DClosePressed}"/></Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButton3DTitleBarStyle}"/>
    <Style x:Key="CloseTitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButton3DCloseTitleBarStyle}"/>

    <!-- Sidebar / breite Aktionsbuttons -->
    <Style x:Key="AppButton3DSidebarBaseStyle" TargetType="Button" BasedOn="{StaticResource AppButton3DCompactSecondaryStyle}">
        <Setter Property="Width" Value="220"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>

    <!-- Startseiten-Kacheln -->
    <LinearGradientBrush x:Key="Btn3DPurpleNormal" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#AB47BC" Offset="0"/><GradientStop Color="#6A1B9A" Offset="0.45"/><GradientStop Color="#4A148C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Btn3DPurpleHover" StartPoint="0,0" EndPoint="0,1">
