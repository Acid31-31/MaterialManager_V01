    <Style x:Key="AppButton3DPurpleStyle" TargetType="Button" BasedOn="{StaticResource AppButton3DBaseStyle}">
        <Setter Property="Background" Value="{StaticResource Btn3DPurpleNormal}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Btn3DPurpleHover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{StaticResource Btn3DPurplePressed}"/></Trigger>
        </Style.Triggers>
