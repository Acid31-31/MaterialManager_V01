    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Btn3DTealHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#63C8BE" Offset="0"/><GradientStop Color="#009688" Offset="0.45"/><GradientStop Color="#00796B" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Btn3DTealPressed" StartPoint="0,0" EndPoint="0,1">
