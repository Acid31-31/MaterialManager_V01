    <LinearGradientBrush x:Key="Btn3DIndigoNormal" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#5C6BC0" Offset="0"/><GradientStop Color="#3949AB" Offset="0.45"/><GradientStop Color="#283593" Offset="1"/>
