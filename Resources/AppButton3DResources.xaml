    <LinearGradientBrush x:Key="Btn3DDangerHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF6E6A" Offset="0"/><GradientStop Color="#D32F2F" Offset="0.45"/><GradientStop Color="#A32222" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Btn3DDangerPressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B71C1C" Offset="0"/><GradientStop Color="#8B1E1E" Offset="0.45"/><GradientStop Color="#601414" Offset="1"/>
    </LinearGradientBrush>

    <!-- Warning / Orange -->
    <LinearGradientBrush x:Key="Btn3DWarningNormal" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFB74D" Offset="0"/><GradientStop Color="#EF6C00" Offset="0.45"/><GradientStop Color="#BF5600" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Btn3DWarningHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFCC80" Offset="0"/><GradientStop Color="#F57C00" Offset="0.45"/><GradientStop Color="#CF6500" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Btn3DWarningPressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E65100" Offset="0"/><GradientStop Color="#BF5600" Offset="0.45"/><GradientStop Color="#8F4100" Offset="1"/>
