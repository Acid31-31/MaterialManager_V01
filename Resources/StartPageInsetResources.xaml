<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Geräterahmen der Startseite (Einbau-Taster-Brushes liegen in AppButton3DResources.xaml) -->
    <LinearGradientBrush x:Key="StartFrameOuterBezel" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#484848" Offset="0"/>
        <GradientStop Color="#2A2A2A" Offset="0.45"/>
        <GradientStop Color="#161616" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StartFrameOuterBezelBorder" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#666666" Offset="0"/>
        <GradientStop Color="#222222" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StartFrameInnerChamber" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#141A22" Offset="0"/>
        <GradientStop Color="#0A0E14" Offset="0.55"/>
        <GradientStop Color="#06080C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StartFrameTitlePlate" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2E343C" Offset="0"/>
        <GradientStop Color="#1A2028" Offset="0.5"/>
        <GradientStop Color="#121820" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StartFrameTileTray" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#080A0E" Offset="0"/>
        <GradientStop Color="#040508" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
