    <ControlTemplate x:Key="AppButton3DInsetTileTemplate" TargetType="Button">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="OuterBezel"
                    CornerRadius="10"
                    Padding="5,5,5,6"
                    Background="{StaticResource StartFrameOuterBezel}"
                    BorderBrush="{StaticResource StartFrameOuterBezelBorder}"
                    BorderThickness="2,2,2,3">
                <Border x:Name="InnerRecess" CornerRadius="6" Background="#030405" Padding="2">
                    <Border x:Name="RecessWall"
                            CornerRadius="5"
                            Background="#06080A"
                            BorderThickness="2,2,2,3"
                            BorderBrush="#000000">
                        <Border x:Name="BacklightPanel"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                ClipToBounds="True">
                            <Grid>
                                <Border x:Name="InnerGlow"
                                        CornerRadius="4"
                                        VerticalAlignment="Bottom"
                                        Height="72"
                                        IsHitTestVisible="False"
                                        Opacity="0.55">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                            <GradientStop Color="#55FFFFFF" Offset="0"/>
                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border x:Name="TopVignette"
                                        CornerRadius="4,4,0,0"
                                        VerticalAlignment="Top"
                                        Height="28"
                                        IsHitTestVisible="False"
                                        Opacity="0.35">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#66000000" Offset="0"/>
                                            <GradientStop Color="#00000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                    </Border>
                </Border>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="BacklightPanel" Property="Opacity" Value="1"/>
                <Setter TargetName="InnerGlow" Property="Opacity" Value="0.78"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="BacklightPanel" Property="Margin" Value="0,1,0,-1"/>
                <Setter TargetName="RecessWall" Property="BorderThickness" Value="3,3,3,2"/>
                <Setter TargetName="InnerGlow" Property="Opacity" Value="0.32"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="OuterBezel" Property="Opacity" Value="0.42"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="AppButton3DInsetTileBaseStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BtnInsetPrimaryNormal}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="158"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template" Value="{StaticResource AppButton3DInsetTileTemplate}"/>
    </Style>

    <Style x:Key="AppButton3DInsetTilePrimaryStyle" TargetType="Button" BasedOn="{StaticResource AppButton3DInsetTileBaseStyle}">
